{{!--
  payment-plan-decision.hbs : Décision sur un échéancier (acceptation ou refus)
  Destinataire : débiteur
  Gabarit : layout.hbs (mention « Merci de ne pas répondre »)
  Objet : subjects.json, clé « payment-plan-decision »
  Données :
    - action_url : Lien du bouton principal (débiteurs : espace débiteur par défaut)
    - case.balance : Solde restant dû, formaté
    - case.deadline (facultatif) : Date limite de règlement ; à défaut, délai standard du niveau
    - case.reference : Référence du dossier
    - plan.approved : Vrai si l'échéancier est accepté
    - plan.installments : Échéances de l'échéancier accepté
    - plan.installments[].amount : Montant de l'échéance
    - plan.installments[].due_date : Date de l'échéance
    - plan.installments[].number : Numéro de l'échéance
    - plan.refusal_reason (facultatif) : Motif du refus
    - plan.total (facultatif) : Total de l'échéancier
  Configuration : config.account_holder, config.bank_name, config.bic, config.cheque_address, config.cheque_payee, config.firm_name, config.iban, config.phone, config.phone_href, config.portal_label, config.portal_url
--}}
{{#> layout}}
{{#*inline "accent"}}{{#if plan.approved}}#15803D{{else}}#C2410C{{/if}}{{/inline}}
{{#*inline "preheader"}}Décision sur votre demande d'échéancier, dossier {{case.reference}}.{{/inline}}
{{#*inline "content"}}
<tr><td style="padding-top:28px;padding-right:40px;padding-bottom:8px;padding-left:40px;"><h1 style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:22px;line-height:1.3;font-weight:bold;color:{{#if plan.approved}}#15803D{{else}}#C2410C{{/if}};">{{#if plan.approved}}Votre échéancier est accepté{{else}}Votre demande d'échéancier n'est pas acceptée{{/if}}</h1><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Madame, Monsieur,</p>{{#if plan.approved}}<p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Nous avons le plaisir de vous informer que votre demande d'échéancier pour le dossier n° <strong>{{case.reference}}</strong> a été acceptée.</p><p style="margin-top:8px;margin-right:0;margin-bottom:10px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;font-weight:bold;letter-spacing:1px;color:#5D7087;">CALENDRIER DES ÉCHÉANCES</p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;"><tr><td align="left" style="padding-top:8px;padding-right:10px;padding-bottom:8px;padding-left:10px;border-bottom:2px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;font-weight:bold;letter-spacing:1px;color:#5D7087;text-align:left;">N°</td><td align="left" style="padding-top:8px;padding-right:10px;padding-bottom:8px;padding-left:10px;border-bottom:2px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;font-weight:bold;letter-spacing:1px;color:#5D7087;text-align:left;">DATE</td><td align="right" style="padding-top:8px;padding-right:10px;padding-bottom:8px;padding-left:10px;border-bottom:2px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;font-weight:bold;letter-spacing:1px;color:#5D7087;text-align:right;">MONTANT</td></tr>{{#each plan.installments}}<tr><td align="left" style="padding-top:9px;padding-right:10px;padding-bottom:9px;padding-left:10px;border-bottom:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.45;color:#111827;text-align:left;vertical-align:top;">{{number}}</td><td align="left" style="padding-top:9px;padding-right:10px;padding-bottom:9px;padding-left:10px;border-bottom:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.45;color:#111827;text-align:left;vertical-align:top;">{{due_date}}</td><td align="right" style="padding-top:9px;padding-right:10px;padding-bottom:9px;padding-left:10px;border-bottom:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.45;color:#111827;text-align:right;vertical-align:top;">{{amount}}</td></tr>{{/each}}</table>{{#if plan.total}}<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin-top:4px;margin-right:0;margin-bottom:0;margin-left:0;"><tr><td width="50%" style="padding-top:14px;padding-right:0;padding-bottom:14px;padding-left:0;border-top:2px solid #15803D;border-bottom:2px solid #15803D;font-family:Arial, Helvetica, sans-serif;font-size:17px;line-height:1.3;font-weight:bold;color:#111827;">Total de l'échéancier</td><td width="50%" align="right" style="padding-top:14px;padding-right:0;padding-bottom:14px;padding-left:0;border-top:2px solid #15803D;border-bottom:2px solid #15803D;font-family:Arial, Helvetica, sans-serif;font-size:22px;line-height:1.3;font-weight:bold;color:#15803D;text-align:right;">{{plan.total}}</td></tr></table>{{/if}}<p style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-size:0;line-height:0;">&nbsp;</p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;"><tr><td bgcolor="#F0FDF4" style="padding-top:18px;padding-right:20px;padding-bottom:18px;padding-left:20px;border-left:4px solid #15803D;background-color:#F0FDF4;"><p style="margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:16px;line-height:1.4;font-weight:bold;color:#15803D;">Respect des échéances</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.65;color:#1F2937;">Chaque échéance doit être réglée au plus tard à sa date, avec la référence <strong>{{case.reference}}</strong>. Une échéance non réglée peut mettre fin à l'échéancier et rendre le solde immédiatement exigible.</p></td></tr></table>{{else}}<p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Après examen, votre demande d'échéancier pour le dossier n° <strong>{{case.reference}}</strong> ne peut pas être acceptée{{#if plan.refusal_reason}}, pour le motif suivant : {{plan.refusal_reason}}{{/if}}.</p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;"><tr><td bgcolor="#FFF7ED" style="padding-top:18px;padding-right:20px;padding-bottom:18px;padding-left:20px;border-left:4px solid #C2410C;background-color:#FFF7ED;"><p style="margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:16px;line-height:1.4;font-weight:bold;color:#C2410C;">Somme exigible</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.65;color:#1F2937;">La somme de <strong>{{case.balance}}</strong> reste due{{#if case.deadline}} et doit être réglée avant le <strong>{{case.deadline}}</strong>{{/if}}. Vous pouvez nous soumettre une nouvelle proposition depuis votre espace en ligne.</p></td></tr></table>{{/if}}</td></tr>
<tr><td style="padding-top:32px;padding-right:40px;padding-bottom:8px;padding-left:40px;"><h2 style="margin-top:0px;margin-right:0;margin-bottom:12px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:17px;line-height:1.3;font-weight:bold;color:#111827;">Moyens de paiement</h2><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;border-radius:8px;"><tr><td bgcolor="#F3F6FA" style="padding-top:16px;padding-right:20px;padding-bottom:16px;padding-left:20px;background-color:#F3F6FA;"><p style="margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#002B74;">Par virement bancaire</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.6;color:#374151;">Titulaire : {{config.account_holder}}{{#if config.bank_name}}, {{config.bank_name}}{{/if}}<br>IBAN : {{config.iban}}<br>BIC : {{config.bic}}<br>Libellé à indiquer : <strong>{{case.reference}}</strong></p></td></tr>
<tr><td bgcolor="#F3F6FA" style="padding-top:16px;padding-right:20px;padding-bottom:16px;padding-left:20px;border-top:1px solid #E2E8F0;background-color:#F3F6FA;"><p style="margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#002B74;">Par chèque</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.6;color:#374151;">À l'ordre de <strong>{{config.cheque_payee}}</strong>, à adresser à {{config.cheque_address}}, avec la référence <strong>{{case.reference}}</strong> au dos.</p></td></tr></table></td></tr>
<tr><td style="padding-top:28px;padding-right:40px;padding-bottom:8px;padding-left:40px;"><table role="presentation" align="center" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin-top:0;margin-right:auto;margin-bottom:0;margin-left:auto;"><tr><td align="center" bgcolor="{{#if plan.approved}}#15803D{{else}}#C2410C{{/if}}" style="border-radius:6px;padding-top:15px;padding-right:28px;padding-bottom:15px;padding-left:28px;background-color:{{#if plan.approved}}#15803D{{else}}#C2410C{{/if}};"><a href="{{#if action_url}}{{action_url}}{{else}}{{config.portal_url}}{{/if}}" target="_blank" style="display:block;font-family:Arial, Helvetica, sans-serif;font-size:17px;line-height:20px;font-weight:bold;color:#FFFFFF;text-decoration:none;">Accéder à mon dossier</a></td></tr></table></td></tr>
<tr><td style="padding-top:24px;padding-right:40px;padding-bottom:36px;padding-left:40px;"><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Pour toute question, contactez-nous au <a href="tel:{{config.phone_href}}" target="_blank" style="color:#002B74;text-decoration:underline;white-space:nowrap;">{{config.phone}}</a> ou consultez votre dossier sur <a href="{{config.portal_url}}" target="_blank" style="color:#002B74;text-decoration:underline;font-weight:bold;">{{config.portal_label}}</a>.</p><p style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Veuillez agréer, Madame, Monsieur, l'expression de nos salutations distinguées.</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.6;color:#111827;"><strong>Le service recouvrement</strong><br><span style="color:#5D7087;">{{config.firm_name}}</span></p></td></tr>
{{/inline}}
{{/layout}}
