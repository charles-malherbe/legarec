{{!--
  debtor-request-received.hbs : Accusé de réception d'une demande
  Destinataire : débiteur
  Gabarit : layout.hbs (mention « Merci de ne pas répondre »)
  Objet : subjects.json, clé « debtor-request-received »
  Données :
    - action_url : Lien du bouton principal (débiteurs : espace débiteur par défaut)
    - case.reference : Référence du dossier
    - request.reference (facultatif) : Référence de la demande
    - request.response_delay (facultatif) : Délai de réponse annoncé (ex. sous 5 jours ouvrés)
    - request.submitted_at (facultatif) : Date de réception
    - request.type_label : Nature de la demande (ex. demande d'échéancier)
  Configuration : config.firm_name, config.phone, config.phone_href, config.portal_label, config.portal_url
--}}
{{#> layout}}
{{#*inline "accent"}}#002B74{{/inline}}
{{#*inline "preheader"}}Votre {{request.type_label}} pour le dossier {{case.reference}} a bien été reçue.{{/inline}}
{{#*inline "content"}}
<tr><td style="padding-top:28px;padding-right:40px;padding-bottom:8px;padding-left:40px;"><h1 style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:22px;line-height:1.3;font-weight:bold;color:#002B74;">Nous avons bien reçu votre demande</h1><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Madame, Monsieur,</p><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Nous accusons réception de votre {{request.type_label}}{{#if request.submitted_at}} du {{request.submitted_at}}{{/if}} concernant le dossier n° <strong>{{case.reference}}</strong>.</p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;border:1px solid #E2E8F0;border-radius:8px;margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;"><tr><td style="padding-top:4px;padding-right:18px;padding-bottom:4px;padding-left:18px;"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;"><tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Demande</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{request.type_label}}</td></tr>{{#if request.reference}}<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Référence de la demande</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{request.reference}}</td></tr>{{/if}}{{#if request.submitted_at}}<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Date de réception</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{request.submitted_at}}</td></tr>{{/if}}<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Dossier</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{case.reference}}</td></tr></table></td></tr></table><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Elle sera examinée par nos services{{#if request.response_delay}} {{request.response_delay}}{{/if}}. Vous serez informé par e-mail de la suite qui lui sera donnée.</p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;"><tr><td bgcolor="#F3F6FA" style="padding-top:18px;padding-right:20px;padding-bottom:18px;padding-left:20px;border-left:4px solid #002B74;background-color:#F3F6FA;"><p style="margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:16px;line-height:1.4;font-weight:bold;color:#002B74;">Délais de paiement</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.65;color:#1F2937;">Sauf accord écrit de notre part, cette demande ne suspend pas les délais de paiement en cours sur votre dossier.</p></td></tr></table></td></tr>
<tr><td style="padding-top:24px;padding-right:40px;padding-bottom:8px;padding-left:40px;"><table role="presentation" align="center" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin-top:0;margin-right:auto;margin-bottom:0;margin-left:auto;"><tr><td align="center" bgcolor="#002B74" style="border-radius:6px;padding-top:15px;padding-right:28px;padding-bottom:15px;padding-left:28px;background-color:#002B74;"><a href="{{#if action_url}}{{action_url}}{{else}}{{config.portal_url}}{{/if}}" target="_blank" style="display:block;font-family:Arial, Helvetica, sans-serif;font-size:17px;line-height:20px;font-weight:bold;color:#FFFFFF;text-decoration:none;">Suivre ma demande</a></td></tr></table></td></tr>
<tr><td style="padding-top:24px;padding-right:40px;padding-bottom:36px;padding-left:40px;"><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Pour toute question, contactez-nous au <a href="tel:{{config.phone_href}}" target="_blank" style="color:#002B74;text-decoration:underline;white-space:nowrap;">{{config.phone}}</a> ou consultez votre dossier sur <a href="{{config.portal_url}}" target="_blank" style="color:#002B74;text-decoration:underline;font-weight:bold;">{{config.portal_label}}</a>.</p><p style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Veuillez agréer, Madame, Monsieur, l'expression de nos salutations distinguées.</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.6;color:#111827;"><strong>Le service recouvrement</strong><br><span style="color:#5D7087;">{{config.firm_name}}</span></p></td></tr>
{{/inline}}
{{/layout}}
