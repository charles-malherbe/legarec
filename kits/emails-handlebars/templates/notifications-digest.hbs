{{!--
  notifications-digest.hbs : Récapitulatif des notifications
  Destinataire : créancier ou collaborateur
  Gabarit : layout.hbs (mention « Merci de ne pas répondre »)
  Objet : subjects.json, clé « notifications-digest »
  Données :
    - action_url : Lien du bouton principal (débiteurs : espace débiteur par défaut)
    - digest.count_label (facultatif) : Nombre de notifications, rédigé (ex. 4 notifications)
    - digest.items : Notifications à afficher
    - digest.items[].case_reference (facultatif) : Référence du dossier
    - digest.items[].date (facultatif) : Date
    - digest.items[].description (facultatif) : Description
    - digest.items[].title : Titre
    - digest.items[].url (facultatif) : Lien
    - digest.more_count (facultatif) : Nombre de notifications non listées
    - digest.period_label (facultatif) : Période couverte
    - recipient.first_name (facultatif) : Prénom du destinataire
    - settings_url (facultatif) : Lien des préférences de notification
  Configuration : config.firm_name
--}}
{{#> layout}}
{{#*inline "accent"}}#002B74{{/inline}}
{{#*inline "preheader"}}{{#if digest.count_label}}{{digest.count_label}} sur vos dossiers{{else}}Les dernières notifications sur vos dossiers{{/if}}.{{/inline}}
{{#*inline "content"}}
<tr><td style="padding-top:28px;padding-right:40px;padding-bottom:8px;padding-left:40px;"><h1 style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:22px;line-height:1.3;font-weight:bold;color:#002B74;">Récapitulatif de vos notifications</h1>{{#if digest.period_label}}<p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.65;color:#5D7087;">{{digest.period_label}}{{#if digest.count_label}} | {{digest.count_label}}{{/if}}</p>{{/if}}<p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">{{#if recipient.first_name}}Bonjour {{recipient.first_name}},{{else}}Bonjour,{{/if}}</p><p style="margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Voici les événements survenus sur vos dossiers :</p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0;">{{#each digest.items}}<tr><td style="padding-top:14px;padding-right:0;padding-bottom:14px;padding-left:0;{{#unless @first}}border-top:1px solid #E2E8F0;{{/unless}}"><p style="margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.4;font-weight:bold;color:#111827;">{{#if url}}<a href="{{url}}" target="_blank" style="color:#002B74;text-decoration:underline;">{{title}}</a>{{else}}{{title}}{{/if}}</p><p style="margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;color:#5D7087;">{{#if case_reference}}Dossier {{case_reference}}{{/if}}{{#if date}} | {{date}}{{/if}}</p>{{#if description}}<p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.55;color:#374151;">{{description}}</p>{{/if}}</td></tr>{{/each}}</table>{{#if digest.more_count}}<p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.65;color:#5D7087;">Et {{digest.more_count}} autre(s) notification(s) dans votre espace.</p>{{/if}}<p style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-size:0;line-height:0;">&nbsp;</p><table role="presentation" align="center" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin-top:0;margin-right:auto;margin-bottom:0;margin-left:auto;"><tr><td align="center" bgcolor="#002B74" style="border-radius:6px;padding-top:15px;padding-right:28px;padding-bottom:15px;padding-left:28px;background-color:#002B74;"><a href="{{action_url}}" target="_blank" style="display:block;font-family:Arial, Helvetica, sans-serif;font-size:17px;line-height:20px;font-weight:bold;color:#FFFFFF;text-decoration:none;">Voir mes notifications</a></td></tr></table>{{#if settings_url}}<p style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-size:0;line-height:0;">&nbsp;</p><p style="margin-top:0;margin-right:0;margin-bottom:0px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.65;color:#5D7087;text-align:center;">Vous recevez ce récapitulatif selon vos préférences de notification. <a href="{{settings_url}}" target="_blank" style="color:#002B74;text-decoration:underline;">Modifier mes préférences</a></p>{{/if}}</td></tr>
<tr><td style="padding-top:24px;padding-right:40px;padding-bottom:36px;padding-left:40px;"><p style="margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Cordialement,</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.6;color:#111827;"><strong>L'équipe {{config.firm_name}}</strong></p></td></tr>
{{/inline}}
{{/layout}}
