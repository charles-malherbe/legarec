{{!--
  remittance-invoice.hbs : Reversement et facture
  Destinataire : créancier
  Gabarit : layout.hbs (mention « Merci de ne pas répondre »)
  Objet : subjects.json, clé « remittance-invoice »
  Données :
    - creditor.name : Nom du créancier mandant
    - invoice.amount_excl_tax : Montant HT
    - invoice.amount_incl_tax : Montant TTC
    - invoice.number : Numéro de la facture d'honoraires
    - invoice.settled_by_offset : Vrai si la facture est réglée par compensation
    - invoice.vat : TVA
    - invoice_url : Lien de téléchargement de la facture
    - lines (facultatif) : Détail par dossier (liste limitée)
    - lines[].case_reference : Référence du dossier
    - lines[].collected : Montant encaissé
    - lines[].debtor_name : Débiteur
    - lines[].net : Montant reversé
    - lines_more (facultatif) : Nombre de dossiers non listés
    - recipient.first_name (facultatif) : Prénom du destinataire
    - remittance.bank_account (facultatif) : Compte crédité (masqué)
    - remittance.collected : Sommes encaissées
    - remittance.date : Date du virement
    - remittance.fees : Honoraires du cabinet
    - remittance.net_amount : Montant reversé
    - remittance.period (facultatif) : Période couverte
    - remittance.reference : Référence du virement
    - statement_url (facultatif) : Lien du relevé détaillé
  Configuration : config.firm_name, config.support_email
--}}
{{#> layout}}
{{#*inline "accent"}}#15803D{{/inline}}
{{#*inline "preheader"}}Reversement de {{remittance.net_amount}} effectué le {{remittance.date}}, facture {{invoice.number}} disponible.{{/inline}}
{{#*inline "content"}}
<tr><td style="padding-top:28px;padding-right:40px;padding-bottom:8px;padding-left:40px;"><h1 style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:22px;line-height:1.3;font-weight:bold;color:#002B74;">Reversement du {{remittance.date}}</h1><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">{{#if recipient.first_name}}Bonjour {{recipient.first_name}},{{else}}Bonjour,{{/if}}</p><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Nous avons procédé au reversement des sommes encaissées pour le compte de <strong>{{creditor.name}}</strong>{{#if remittance.period}} sur la période {{remittance.period}}{{/if}}.</p><p style="margin-top:0px;margin-right:0;margin-bottom:10px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;font-weight:bold;letter-spacing:1px;color:#5D7087;">REVERSEMENT</p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;border:1px solid #E2E8F0;border-radius:8px;"><tr><td style="padding-top:4px;padding-right:18px;padding-bottom:4px;padding-left:18px;"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;"><tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Sommes encaissées</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{remittance.collected}}</td></tr>
<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Honoraires du cabinet</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{remittance.fees}}</td></tr>
<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Montant reversé</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{remittance.net_amount}}</td></tr>
<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Date du virement</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{remittance.date}}</td></tr>{{#if remittance.bank_account}}<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Compte crédité</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{remittance.bank_account}}</td></tr>{{/if}}<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Référence du virement</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{remittance.reference}}</td></tr></table></td></tr></table><p style="margin-top:24px;margin-right:0;margin-bottom:10px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;font-weight:bold;letter-spacing:1px;color:#5D7087;">FACTURE</p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;border:1px solid #E2E8F0;border-radius:8px;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0;"><tr><td style="padding-top:4px;padding-right:18px;padding-bottom:4px;padding-left:18px;"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;"><tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Facture n°</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{invoice.number}}</td></tr>
<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Montant HT</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{invoice.amount_excl_tax}}</td></tr>
<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">TVA</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{invoice.vat}}</td></tr>
<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Montant TTC</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{invoice.amount_incl_tax}}</td></tr></table></td></tr></table>{{#if invoice.settled_by_offset}}<p style="margin-top:0;margin-right:0;margin-bottom:0px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.65;color:#5D7087;">Cette facture est réglée par compensation : son montant a été déduit du présent reversement.</p>{{/if}}{{#if lines}}<p style="margin-top:24px;margin-right:0;margin-bottom:10px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;font-weight:bold;letter-spacing:1px;color:#5D7087;">DÉTAIL PAR DOSSIER</p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;"><tr><td align="left" style="padding-top:8px;padding-right:10px;padding-bottom:8px;padding-left:10px;border-bottom:2px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;font-weight:bold;letter-spacing:1px;color:#5D7087;text-align:left;">DOSSIER</td><td align="right" style="padding-top:8px;padding-right:10px;padding-bottom:8px;padding-left:10px;border-bottom:2px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;font-weight:bold;letter-spacing:1px;color:#5D7087;text-align:right;">ENCAISSÉ</td><td align="right" style="padding-top:8px;padding-right:10px;padding-bottom:8px;padding-left:10px;border-bottom:2px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;font-weight:bold;letter-spacing:1px;color:#5D7087;text-align:right;">REVERSÉ</td></tr>{{#each lines}}<tr><td align="left" style="padding-top:9px;padding-right:10px;padding-bottom:9px;padding-left:10px;border-bottom:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.45;color:#111827;text-align:left;vertical-align:top;"><strong>{{case_reference}}</strong><br><span style="color:#5D7087;font-size:13px;">{{debtor_name}}</span></td><td align="right" style="padding-top:9px;padding-right:10px;padding-bottom:9px;padding-left:10px;border-bottom:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.45;color:#111827;text-align:right;vertical-align:top;">{{collected}}</td><td align="right" style="padding-top:9px;padding-right:10px;padding-bottom:9px;padding-left:10px;border-bottom:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.45;color:#111827;text-align:right;vertical-align:top;">{{net}}</td></tr>{{/each}}</table>{{#if lines_more}}<p style="margin-top:0;margin-right:0;margin-bottom:0px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.65;color:#5D7087;">Et {{lines_more}} autre(s) dossier(s) dans le relevé détaillé.</p>{{/if}}{{/if}}<p style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-size:0;line-height:0;">&nbsp;</p><table role="presentation" align="center" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin-top:0;margin-right:auto;margin-bottom:0;margin-left:auto;"><tr><td align="center" bgcolor="#002B74" style="border-radius:6px;padding-top:15px;padding-right:28px;padding-bottom:15px;padding-left:28px;background-color:#002B74;"><a href="{{invoice_url}}" target="_blank" style="display:block;font-family:Arial, Helvetica, sans-serif;font-size:17px;line-height:20px;font-weight:bold;color:#FFFFFF;text-decoration:none;">Télécharger la facture</a></td></tr></table>{{#if statement_url}}<p style="margin-top:0;margin-right:0;margin-bottom:0px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.65;color:#374151;text-align:center;"><a href="{{statement_url}}" target="_blank" style="color:#002B74;text-decoration:underline;">Voir le relevé détaillé</a></p>{{/if}}</td></tr>
<tr><td style="padding-top:24px;padding-right:40px;padding-bottom:36px;padding-left:40px;"><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Pour toute question, écrivez-nous à <a href="mailto:{{config.support_email}}" target="_blank" style="color:#002B74;text-decoration:underline;">{{config.support_email}}</a>.</p><p style="margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Cordialement,</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.6;color:#111827;"><strong>L'équipe {{config.firm_name}}</strong></p></td></tr>
{{/inline}}
{{/layout}}
