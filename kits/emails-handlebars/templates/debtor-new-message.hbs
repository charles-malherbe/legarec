{{!--
  debtor-new-message.hbs : Nouveau message du cabinet
  Destinataire : débiteur
  Gabarit : layout.hbs (mention « Merci de ne pas répondre »)
  Objet : subjects.json, clé « debtor-new-message »
  Données :
    - action_url : Lien du bouton principal (débiteurs : espace débiteur par défaut)
    - case.reference : Référence du dossier
    - creditor.name : Nom du créancier mandant
    - message.sent_at (facultatif) : Date du message
    - message.subject (facultatif) : Objet du message
  Configuration : config.firm_name, config.phone, config.phone_href, config.portal_label, config.portal_url
--}}
{{#> layout}}
{{#*inline "accent"}}#002B74{{/inline}}
{{#*inline "preheader"}}Un nouveau message vous attend dans votre espace, dossier {{case.reference}}.{{/inline}}
{{#*inline "content"}}
<tr><td style="padding-top:28px;padding-right:40px;padding-bottom:8px;padding-left:40px;"><h1 style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:22px;line-height:1.3;font-weight:bold;color:#002B74;">Nouveau message concernant votre dossier</h1><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Madame, Monsieur,</p><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Un nouveau message de nos services concernant le dossier n° <strong>{{case.reference}}</strong>{{#if creditor.name}} (créancier : {{creditor.name}}){{/if}} est disponible dans votre espace en ligne{{#if message.sent_at}} depuis le {{message.sent_at}}{{/if}}.</p>{{#if message.subject}}<p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Objet : <strong>{{message.subject}}</strong></p>{{/if}}<p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Pour des raisons de confidentialité, son contenu n'est consultable qu'après identification sur <a href="{{config.portal_url}}" target="_blank" style="color:#002B74;text-decoration:underline;font-weight:bold;">{{config.portal_label}}</a>, avec votre SIREN et votre code de paiement.</p></td></tr>
<tr><td style="padding-top:8px;padding-right:40px;padding-bottom:8px;padding-left:40px;"><table role="presentation" align="center" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin-top:0;margin-right:auto;margin-bottom:0;margin-left:auto;"><tr><td align="center" bgcolor="#002B74" style="border-radius:6px;padding-top:15px;padding-right:28px;padding-bottom:15px;padding-left:28px;background-color:#002B74;"><a href="{{#if action_url}}{{action_url}}{{else}}{{config.portal_url}}{{/if}}" target="_blank" style="display:block;font-family:Arial, Helvetica, sans-serif;font-size:17px;line-height:20px;font-weight:bold;color:#FFFFFF;text-decoration:none;">Lire le message</a></td></tr></table></td></tr>
<tr><td style="padding-top:24px;padding-right:40px;padding-bottom:36px;padding-left:40px;"><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Pour toute question, contactez-nous au <a href="tel:{{config.phone_href}}" target="_blank" style="color:#002B74;text-decoration:underline;white-space:nowrap;">{{config.phone}}</a> ou consultez votre dossier sur <a href="{{config.portal_url}}" target="_blank" style="color:#002B74;text-decoration:underline;font-weight:bold;">{{config.portal_label}}</a>.</p><p style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Veuillez agréer, Madame, Monsieur, l'expression de nos salutations distinguées.</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.6;color:#111827;"><strong>Le service recouvrement</strong><br><span style="color:#5D7087;">{{config.firm_name}}</span></p></td></tr>
{{/inline}}
{{/layout}}
