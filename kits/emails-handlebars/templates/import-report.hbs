{{!--
  import-report.hbs : Rapport d'import
  Destinataire : créancier
  Gabarit : layout.hbs (mention « Merci de ne pas répondre »)
  Objet : subjects.json, clé « import-report »
  Données :
    - creditor.name : Nom du créancier mandant
    - import.created : Nombre de dossiers créés
    - import.date (facultatif) : Date de l'import
    - import.errors (facultatif) : Lignes rejetées (liste limitée)
    - import.errors[].line : Numéro de ligne
    - import.errors[].message : Motif du rejet
    - import.errors_more (facultatif) : Nombre de rejets non listés
    - import.file_name : Nom du fichier importé
    - import.has_errors : Vrai si des lignes ont été rejetées
    - import.rejected : Nombre de lignes rejetées
    - import.total_rows : Nombre de lignes traitées
    - import.updated : Nombre de dossiers mis à jour
    - recipient.first_name (facultatif) : Prénom du destinataire
    - report_url : Lien du rapport complet
  Configuration : config.firm_name, config.support_email
--}}
{{#> layout}}
{{#*inline "accent"}}{{#if import.has_errors}}#C2410C{{else}}#15803D{{/if}}{{/inline}}
{{#*inline "preheader"}}Import de {{import.file_name}} : {{import.created}} créé(s), {{import.updated}} mis à jour, {{import.rejected}} rejeté(s).{{/inline}}
{{#*inline "content"}}
<tr><td style="padding-top:28px;padding-right:40px;padding-bottom:8px;padding-left:40px;"><h1 style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:22px;line-height:1.3;font-weight:bold;color:{{#if import.has_errors}}#C2410C{{else}}#15803D{{/if}};">{{#if import.has_errors}}Import terminé avec des anomalies{{else}}Import terminé{{/if}}</h1><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">{{#if recipient.first_name}}Bonjour {{recipient.first_name}},{{else}}Bonjour,{{/if}}</p><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">L'import du fichier <strong>{{import.file_name}}</strong>{{#if import.date}} du {{import.date}}{{/if}}{{#if creditor.name}} pour {{creditor.name}}{{/if}} est terminé.</p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;border:1px solid #E2E8F0;border-radius:8px;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0;"><tr><td style="padding-top:4px;padding-right:18px;padding-bottom:4px;padding-left:18px;"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;"><tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Lignes traitées</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{import.total_rows}}</td></tr>
<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Dossiers créés</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{import.created}}</td></tr>
<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Dossiers mis à jour</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{import.updated}}</td></tr>
<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Lignes rejetées</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{import.rejected}}</td></tr></table></td></tr></table>{{#if import.errors}}<p style="margin-top:24px;margin-right:0;margin-bottom:10px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;font-weight:bold;letter-spacing:1px;color:#5D7087;">LIGNES REJETÉES</p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;"><tr><td align="left" style="padding-top:8px;padding-right:10px;padding-bottom:8px;padding-left:10px;border-bottom:2px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;font-weight:bold;letter-spacing:1px;color:#5D7087;text-align:left;">LIGNE</td><td align="left" style="padding-top:8px;padding-right:10px;padding-bottom:8px;padding-left:10px;border-bottom:2px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;font-weight:bold;letter-spacing:1px;color:#5D7087;text-align:left;">MOTIF</td></tr>{{#each import.errors}}<tr><td align="left" style="padding-top:9px;padding-right:10px;padding-bottom:9px;padding-left:10px;border-bottom:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.45;color:#111827;text-align:left;vertical-align:top;">{{line}}</td><td align="left" style="padding-top:9px;padding-right:10px;padding-bottom:9px;padding-left:10px;border-bottom:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.45;color:#111827;text-align:left;vertical-align:top;">{{message}}</td></tr>{{/each}}</table>{{#if import.errors_more}}<p style="margin-top:0;margin-right:0;margin-bottom:0px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.65;color:#5D7087;">Et {{import.errors_more}} autre(s) ligne(s) rejetée(s), détaillée(s) dans le rapport complet.</p>{{/if}}<p style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-size:0;line-height:0;">&nbsp;</p>{{/if}}{{#if import.has_errors}}<p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Les lignes rejetées n'ont pas été importées : corrigez-les puis importez-les de nouveau.</p>{{/if}}<table role="presentation" align="center" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin-top:0;margin-right:auto;margin-bottom:0;margin-left:auto;"><tr><td align="center" bgcolor="#002B74" style="border-radius:6px;padding-top:15px;padding-right:28px;padding-bottom:15px;padding-left:28px;background-color:#002B74;"><a href="{{report_url}}" target="_blank" style="display:block;font-family:Arial, Helvetica, sans-serif;font-size:17px;line-height:20px;font-weight:bold;color:#FFFFFF;text-decoration:none;">Voir le rapport</a></td></tr></table></td></tr>
<tr><td style="padding-top:24px;padding-right:40px;padding-bottom:36px;padding-left:40px;"><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Pour toute question, écrivez-nous à <a href="mailto:{{config.support_email}}" target="_blank" style="color:#002B74;text-decoration:underline;">{{config.support_email}}</a>.</p><p style="margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Cordialement,</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.6;color:#111827;"><strong>L'équipe {{config.firm_name}}</strong></p></td></tr>
{{/inline}}
{{/layout}}
