{{!--
  case-closed.hbs : Dossier soldé
  Destinataire : débiteur
  Gabarit : layout.hbs (mention « Merci de ne pas répondre »)
  Objet : subjects.json, clé « case-closed »
  Données :
    - case.closed_date (facultatif) : Date de clôture du dossier
    - case.reference : Référence du dossier
    - case.total_paid (facultatif) : Total réglé sur le dossier
    - certificate_url (facultatif) : Lien de l'attestation de solde
    - creditor.name : Nom du créancier mandant
  Configuration : config.firm_name
--}}
{{#> layout}}
{{#*inline "accent"}}#15803D{{/inline}}
{{#*inline "preheader"}}Le dossier {{case.reference}} est soldé : aucune somme ne reste due.{{/inline}}
{{#*inline "content"}}
<tr><td style="padding-top:28px;padding-right:40px;padding-bottom:8px;padding-left:40px;"><h1 style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:22px;line-height:1.3;font-weight:bold;color:#15803D;">Votre dossier est soldé</h1><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Madame, Monsieur,</p><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Nous vous confirmons que le dossier n° <strong>{{case.reference}}</strong>, ouvert pour le compte de <strong>{{creditor.name}}</strong>, est soldé{{#if case.closed_date}} depuis le {{case.closed_date}}{{/if}}.</p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;border:1px solid #E2E8F0;border-radius:8px;margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;"><tr><td style="padding-top:4px;padding-right:18px;padding-bottom:4px;padding-left:18px;"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;"><tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Dossier</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{case.reference}}</td></tr>
<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Créancier</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{creditor.name}}</td></tr>{{#if case.total_paid}}<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Total réglé</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{case.total_paid}}</td></tr>{{/if}}{{#if case.closed_date}}<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Date de clôture</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{case.closed_date}}</td></tr>{{/if}}</table></td></tr></table><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Aucune somme ne reste due au titre de ce dossier et la procédure de recouvrement est arrêtée. Nous vous remercions de votre règlement et vous conseillons de conserver ce message.</p>{{#if certificate_url}}<table role="presentation" align="center" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin-top:0;margin-right:auto;margin-bottom:0;margin-left:auto;"><tr><td align="center" bgcolor="#15803D" style="border-radius:6px;padding-top:15px;padding-right:28px;padding-bottom:15px;padding-left:28px;background-color:#15803D;"><a href="{{certificate_url}}" target="_blank" style="display:block;font-family:Arial, Helvetica, sans-serif;font-size:17px;line-height:20px;font-weight:bold;color:#FFFFFF;text-decoration:none;">Télécharger l'attestation</a></td></tr></table>{{/if}}</td></tr>
<tr><td style="padding-top:24px;padding-right:40px;padding-bottom:36px;padding-left:40px;"><p style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Veuillez agréer, Madame, Monsieur, l'expression de nos salutations distinguées.</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.6;color:#111827;"><strong>Le service recouvrement</strong><br><span style="color:#5D7087;">{{config.firm_name}}</span></p></td></tr>
{{/inline}}
{{/layout}}
