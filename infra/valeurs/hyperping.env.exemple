# /etc/legarec/hyperping.env : adresses de ping des healthchecks Hyperping (facultatif). Lu par systemd seul : root, 600.
# Sans ce fichier, ou une ligne vide, rien n'est envoyé.
HYPERPING_PING_SAUVEGARDE=[ADRESSE DE PING DU HEALTHCHECK « SAUVEGARDE DE LA NUIT »]
HYPERPING_PING_RESTAURATION=[ADRESSE DE PING DU HEALTHCHECK « ESSAI DE RESTAURATION »]
