# /etc/legarec/api.env : API. Mêmes VAULT_MASTER_KEY, SESSION_SIGNING_KEY et VALKEY_URL que worker.env.
# DATABASE_URL : postgresql://legarec_app:<LEGAREC_APP_PASSWORD>@postgres:5432/legarec
# VALKEY_URL : redis://:<VALKEY_PASSWORD>@valkey:6379/0
DATABASE_URL=
VALKEY_URL=
VAULT_MASTER_KEY=
SESSION_SIGNING_KEY=
STAFF_PORTAL_URL=https://espace.legarec.fr
PARTNER_PORTAL_URL=https://partenaires.legarec.fr
DEBTOR_PORTAL_URL=https://paiement.legarec.fr
MYSENDINGBOX_ENV=test
# Facultatives : ne les écrire qu'avec une valeur (une ligne vide est refusée au démarrage).
# VAULT_MASTER_KEY_PREVIOUS, SESSION_SIGNING_KEY_PREVIOUS, LOG_LEVEL, AI_ENABLED, IA_MODELE_RAPIDE, IA_MODELE_AVANCE,
# AI_BASE_URL, S3_REGION, S3_DOCUMENTS_BUCKET
