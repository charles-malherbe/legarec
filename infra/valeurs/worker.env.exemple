# /etc/legarec/worker.env : worker. Mêmes VAULT_MASTER_KEY, SESSION_SIGNING_KEY et VALKEY_URL que api.env.
# JOBS_DATABASE_URL : postgresql://legarec_jobs:<LEGAREC_JOBS_PASSWORD>@postgres:5432/legarec
JOBS_DATABASE_URL=
VALKEY_URL=
VAULT_MASTER_KEY=
SESSION_SIGNING_KEY=
STAFF_PORTAL_URL=https://espace.legarec.fr
PARTNER_PORTAL_URL=https://partenaires.legarec.fr
DEBTOR_PORTAL_URL=https://paiement.legarec.fr
MYSENDINGBOX_ENV=test
# RESEND_ENV : test tant que les relances ne doivent atteindre aucun débiteur (seules les adresses @resend.dev reçoivent) ;
# production à la mise en service.
RESEND_ENV=test
# Facultatives : comme api.env. S3_DOCUMENTS_BUCKET et S3_REGION : jamais dans un seul des deux fichiers.
