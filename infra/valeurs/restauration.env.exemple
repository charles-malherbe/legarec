# /etc/legarec/restauration.env : essai de restauration. Clé S3 en lecture seule ; même phrase de chiffrement.
# GATUS_PUSH_TOKEN : GATUS_RESTORE_TOKEN de gatus.env.
PGBACKREST_REPO1_S3_REGION=[RÉGION]
PGBACKREST_REPO1_S3_ENDPOINT=s3.[RÉGION].scw.cloud
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
PGBACKREST_REPO1_CIPHER_PASS=
GATUS_PUSH_TOKEN=
