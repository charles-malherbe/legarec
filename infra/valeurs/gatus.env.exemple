# /etc/legarec/gatus.env : contrôles internes et alertes.
GATUS_ALERT_KEY=
GATUS_ALERT_TO=[ADRESSE QUI REÇOIT LES ALERTES]
# Trois jetons différents, un par programme : chacun est aussi GATUS_PUSH_TOKEN dans worker.env, pgbackrest.env et
# restauration.env.
GATUS_WORKER_TOKEN=
GATUS_BACKUP_TOKEN=
GATUS_RESTORE_TOKEN=
