#!/bin/bash
# Restores the latest backup and its journal in a temporary container, starts it, reads it, and says so. The restored
# server never archives, opens no port, and disappears with the container.
set -euo pipefail
data=/restauration/data
socket=/restauration/socket
trap 'pg_ctl --pgdata "$data" --mode immediate --silent stop 2>/dev/null || true; rm -rf "$data" "$socket"' EXIT
rm -rf "$data"
mkdir -m 700 -p "$socket"
# The journal is fetched with the keys of the backups, like everything else.
legarec-pgbackrest --pg1-path="$data" --archive-mode=off --type=default \
  --recovery-option=restore_command="legarec-pgbackrest --pg1-path=$data archive-get %f \"%p\"" restore
options="-c listen_addresses='' -c unix_socket_directories=$socket -c hba_file=/etc/legarec/pg_hba.conf"
options+=" -c shared_buffers=64MB -c max_connections=60 -c log_min_messages=log -c log_min_error_statement=panic"
pg_ctl --pgdata "$data" --wait --timeout 3600 --options "$options" --silent start
ask() { psql --no-psqlrc --quiet --tuples-only --no-align --set ON_ERROR_STOP=1 --host "$socket" --username postgres --dbname legarec "$@"; }
for _ in $(seq 300); do
  [ "$(ask --command 'SELECT pg_is_in_recovery()')" = f ] && break
  sleep 2
done
# The server has its tables, and their last migration.
ask --command "DO \$\$ BEGIN
  IF pg_is_in_recovery() THEN RAISE EXCEPTION 'not recovered'; END IF;
  IF NOT EXISTS (SELECT FROM _prisma_migrations WHERE finished_at IS NOT NULL) THEN RAISE EXCEPTION 'no migration'; END IF;
END \$\$"
# Every row is read: a damaged one is found here, and not the day it is needed.
pg_dump --host "$socket" --username postgres --dbname legarec --file /dev/null
echo 'restore test passed'
# Not told: the monitoring raises the alarm by itself.
legarec-tell sauvegardes_essai-de-restauration || echo 'monitoring not told' >&2
