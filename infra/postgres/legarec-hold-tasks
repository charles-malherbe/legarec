#!/bin/bash
# After a restoration, before the worker starts: what had not left at the moment restored may have left since. Every task
# not done, planned ones included, becomes uncertain, as after an interruption: a person checks with the provider, and nothing leaves twice.
set -euo pipefail
psql --no-psqlrc --set ON_ERROR_STOP=1 --username postgres --dbname legarec <<'SQL'
WITH held AS (
  UPDATE outbox SET failed_at = now(), failure = 'UNCERTAIN' WHERE done_at IS NULL AND failed_at IS NULL RETURNING queue, name
)
SELECT queue, name, count(*) FROM held GROUP BY queue, name ORDER BY queue, name;
SQL
