[Unit]
Description=Legarec : Essai de restauration chaque lundi
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/legarec
ExecStart=/usr/bin/docker compose --env-file /etc/legarec/version.env run --rm essai-restauration
TimeoutStartSec=6h
