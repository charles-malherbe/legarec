[Unit]
Description=Legarec : Essai de restauration chaque lundi
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/legarec
ExecStart=/usr/bin/docker compose --file docker-compose.yml --env-file /etc/legarec/version.env run --rm essai-restauration
# Hyperping (healthcheck), after a success only: it warns when the ping stops coming. Without the file, nothing.
EnvironmentFile=-/etc/legarec/hyperping.env
ExecStartPost=-/opt/legarec/infra/hyperping/signaler HYPERPING_PING_RESTAURATION
TimeoutStartSec=6h
# The container already logs to Loki, where its lines end after 60 days.
StandardOutput=null
