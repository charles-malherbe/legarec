[Unit]
Description=Legarec : Sauvegarde complète chaque dimanche
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/legarec
ExecStart=/usr/bin/flock --timeout 3600 /run/legarec-sauvegarde.lock /usr/bin/docker compose --file docker-compose.yml --env-file /etc/legarec/version.env run --rm sauvegarde full
# Hyperping (healthcheck), after a success only: it warns when the ping stops coming. Without the file, nothing.
EnvironmentFile=-/etc/legarec/hyperping.env
ExecStartPost=-/opt/legarec/infra/hyperping/signaler HYPERPING_PING_SAUVEGARDE
TimeoutStartSec=6h
# The container already logs to Loki, where its lines end after 60 days.
StandardOutput=null
