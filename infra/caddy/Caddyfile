# Reverse proxy of production, after kits/caddy/Caddyfile.exemple. No secret here: the values that depend on the server
# come from /etc/legarec/caddy.env (ACME_EMAIL, AUTHORIZED_IPS, S3_REGION). Without AUTHORIZED_IPS, nobody is authorised.
{
	email {$ACME_EMAIL}
	# No remote control, and nothing written but the certificates.
	admin off
	persist_config off
	grace_period 20s
	servers {
		timeouts {
			read_header 10s
			read_body 5m
			idle 2m
		}
	}
	# What goes wrong, without the address of the caller, the headers, nor the path (it may carry a token).
	log default {
		output stdout
		format filter {
			wrap json
			fields {
				request delete
				user_id delete
				resp_headers delete
			}
		}
	}
}

# One line per request: host, method, status, duration, size. Never the address of the caller, the headers nor the path.
(access_log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>uri delete
				request>tls delete
				user_id delete
				resp_headers delete
			}
		}
	}
}

# Same, with the family of the route: the API itself logs the model of each route.
(api_access_log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>uri regexp "^(?:/(staff|partner|debtor|public|hooks|service|health)(?:[/?].*)?|.*)$" "/${1}"
				request>tls delete
				user_id delete
				resp_headers delete
			}
		}
	}
}

# Headers of every site. Set last, over those of the containers.
(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
		-Via
		defer
	}
	encode zstd gzip
}

# {args[0]}: container of the portal. Nothing comes from elsewhere, except the API, the logos and the styles that
# Mantine and FullCalendar write in the page ('unsafe-inline' for the styles only, never for the scripts).
# {args[2]}: what else the portal may read, the public registers of its forms (DECISIONS.md, 28/11/2026).
(portal) {
	import security
	import access_log
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://media.legarec.fr; connect-src https://api.legarec.fr {args[2]}; frame-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'none'; object-src 'none'; manifest-src 'self'"
		Referrer-Policy {args[1]}
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		defer
	}
	request_body {
		max_size 1KB
	}
	reverse_proxy {args[0]}:8080
}

# Only from the addresses of the firm.
(firm_only) {
	@outside not remote_ip {$AUTHORIZED_IPS}
	respond @outside 403
}

espace.legarec.fr {
	import portal espace strict-origin-when-cross-origin "https://data.geopf.fr https://geo.api.gouv.fr https://recherche-entreprises.api.gouv.fr https://data-api.ecb.europa.eu https://calendrier.api.gouv.fr"
}

partenaires.legarec.fr {
	import portal partenaires strict-origin-when-cross-origin "https://api.legarec.fr https://calendrier.api.gouv.fr"
}

# The path may carry the link of a letter or of a text message: it never leaves with a click.
paiement.legarec.fr {
	import portal paiement no-referrer "https://api.legarec.fr https://calendrier.api.gouv.fr"
}

api.legarec.fr {
	import security
	import api_access_log
	# Root only, to the status page.
	redir / https://status.legarec.fr 302
	# Service accounts (n8n) reach the API from inside.
	@service path /service /service/*
	respond @service 404
	# The largest attachment the screens accept is 25 MB.
	request_body {
		max_size 28MB
	}
	reverse_proxy api:3000 {
		# Not set by the caller: Caddy replaces X-Forwarded-For with the address it sees.
		header_up -Forwarded
		header_up -X-Real-IP
	}
}

status.legarec.fr {
	import security
	import access_log
	header {
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
	}
	@firm remote_ip {$AUTHORIZED_IPS}
	# Technical logs (Grafana), from the addresses of the firm only, behind its own password.
	@logs path /journaux /journaux/*
	handle @logs {
		import firm_only
		reverse_proxy grafana:3000
	}
	# Results pushed by the worker and the backups stay inside.
	@push path_regexp (?i)^/api/v1/endpoints/[^/]+/external/?$
	handle @push {
		respond 404
	}
	# Internal checks (backups, restore tests, tasks, logs), from the addresses of the firm only.
	handle @firm {
		reverse_proxy gatus-interne:8080
	}
	# Everybody else: the portals and the API.
	handle {
		reverse_proxy gatus:8080
	}
}

n8n.legarec.fr {
	import security
	import access_log
	import firm_only
	# Its data stay in its own volume; it reaches the API by the network `automatisations`, never by this address.
	reverse_proxy n8n:5678
}

# The copy of the public files kept in the image (infra/media, same paths as the bucket), for when the bucket does not
# exist yet, refuses, lacks the file or does not answer (DECISIONS.md, 27/11/2026).
(media_kept) {
	root * /srv/media
	@kept file
	header @kept Cache-Control "public, max-age=31536000, immutable"
}

media.legarec.fr {
	import security
	import access_log
	# Root only, to the public website.
	redir / https://legarec.fr 302
	# An image or a document, never a page that runs something.
	header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'"
	@change not method GET HEAD
	respond @change 405
	# A folder is never listed, neither by the bucket nor by the copy.
	@folder path */
	respond @folder 404
	# Public bucket first.
	rewrite * ?
	reverse_proxy https://legarec-media.s3.{$S3_REGION}.io.cloud.ovh.net {
		header_up Host legarec-media.s3.{$S3_REGION}.io.cloud.ovh.net
		header_up -Authorization
		header_up -Cookie
		# Who looks at a logo, and where, stays with the firm.
		header_up -X-Forwarded-For
		header_up -X-Forwarded-Host
		header_up -Referer
		header_up -User-Agent
		header_down -Set-Cookie
		# Nothing of the provider goes down to the visitor.
		header_down -X-Amz-*
		# A bucket that does not answer gives way to the copy within seconds, not when the mail client gives up.
		transport http {
			dial_timeout 3s
			tls_timeout 3s
			response_header_timeout 5s
		}
		# Versioned paths, never replaced: kept for a year, but not an error.
		@found status 200 206 304
		handle_response @found {
			header Cache-Control "public, max-age=31536000, immutable"
			copy_response
		}
		# Bucket absent, refusing or without the file: the copy, or 404 without the answer of the provider.
		handle_response {
			import media_kept
			file_server @kept
			@missing not file
			respond @missing 404
		}
	}
	# Bucket unreachable: the copy, or the 502 of the proxy. A file served while handling an error keeps the code of the
	# error unless told otherwise: 200, for the whole file, since nothing partial or conditional can be answered with it.
	handle_errors 502 503 504 {
		import security
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'"
		import media_kept
		request_header -Range
		request_header -If-*
		file_server @kept {
			status 200
		}
	}
}

# Redirections, without any parameter. The path of a letter may be in them: it never leaves with a click.
(without_www) {
	import security
	header Referrer-Policy "no-referrer"
	route {
		rewrite * ?
		redir https://{args[0]}.legarec.fr{uri} 301
	}
}

www.espace.legarec.fr {
	# Same address without www.
	import without_www espace
}

www.partenaires.legarec.fr {
	# Same address without www.
	import without_www partenaires
}

www.paiement.legarec.fr {
	# Same address without www.
	import without_www paiement
}

mail.legarec.fr {
	import security
	# Sends e-mails only: its web page is the public website.
	redir https://legarec.fr 301
}

# Asked by the health check of its own container; reachable from nowhere else.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /health 200
}
