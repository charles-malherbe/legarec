#!/bin/sh
# Gives its values to Grafana, and to no other program. The file is read, never run.
set -eu
for name in GF_SECURITY_ADMIN_PASSWORD GF_SECURITY_SECRET_KEY; do
  value="$(sed -n "s/^$name=//p" /run/secrets/grafana | head -n 1)"
  [ -n "$value" ] || { echo "Missing value: $name" >&2; exit 1; }
  export "$name=$value"
done
exec /run.sh "$@"
