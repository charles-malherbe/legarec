#!/bin/sh
# Gives its password to Grafana, and to no other program. The file is read, never run.
set -eu
GF_SECURITY_ADMIN_PASSWORD="$(sed -n 's/^GF_SECURITY_ADMIN_PASSWORD=//p' /run/secrets/grafana | head -n 1)"
[ -n "$GF_SECURITY_ADMIN_PASSWORD" ] || { echo 'Missing value: GF_SECURITY_ADMIN_PASSWORD' >&2; exit 1; }
export GF_SECURITY_ADMIN_PASSWORD
exec /run.sh "$@"
