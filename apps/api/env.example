# Names only: the values are typed outside of Git by the firm, never by Claude Code. See docs/api.md.

# --- Startup values. Production: /etc/legarec/api.env (API), worker.env and migration.env, on the server.
# Development: drawn at random by infra/dev/services.mjs, nothing to type.
# One account of PostgreSQL per program: API, worker, migrations.
DATABASE_URL=
JOBS_DATABASE_URL=
MIGRATION_DATABASE_URL=
VALKEY_URL=
VAULT_MASTER_KEY=
SESSION_SIGNING_KEY=
STAFF_PORTAL_URL=
PARTNER_PORTAL_URL=
DEBTOR_PORTAL_URL=
TRUSTED_PROXIES=
LOG_LEVEL=
MYSENDINGBOX_ENV=
AI_ENABLED=
IA_MODELE_RAPIDE=
IA_MODELE_AVANCE=
AI_BASE_URL=
SCW_REGION=
SCW_DOCUMENTS_BUCKET=

# --- Test keys, for development only: `.env` at the root of the checkout. No OVH nor 3CX key: they have no test mode.
# In production, the keys of the services are typed in Paramètres techniques > Secrets.
RESEND_API_KEY=
MYSENDINGBOX_TEST_API_KEY=
DEV_RECIPIENTS=

