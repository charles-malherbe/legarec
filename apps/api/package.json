{
  "name": "@legarec/api",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "generate": "CHECKPOINT_DISABLE=1 PRISMA_SCHEMA_ENGINE_BINARY=/usr/bin/false prisma generate",
    "typecheck": "tsc -p tsconfig.json",
    "build": "pnpm -s generate && vite build",
    "dev": "node ../../infra/dev/api.mjs",
    "account": "node ../../infra/dev/api.mjs account",
    "seed": "node prisma/seed/seed.mjs",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "@legarec/contracts": "workspace:*",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/swagger": "12.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@simplewebauthn/server": "14.1.0",
    "argon2": "0.45.2",
    "bullmq": "6.7.9",
    "handlebars": "4.7.10",
    "ioredis": "6.1.0",
    "libphonenumber-js": "1.13.17",
    "otplib": "13.6.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "playwright": "1.65.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.6.0",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "fast-check": "4.11.0",
    "openapi-typescript": "7.13.0",
    "prisma": "7.10.1"
  }
}
