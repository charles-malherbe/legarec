{{!--
  staff-invitation.hbs : Invitation collaborateur
  Destinataire : collaborateur
  Gabarit : layout.hbs (mention « Merci de ne pas répondre »)
  Objet : subjects.json, clé « staff-invitation »
  Données :
    - expires_in (facultatif) : Durée de validité du lien (ex. 24 heures)
    - invitation_url : Lien d'activation de l'accès
    - inviter.name : Nom de la personne qui invite
    - recipient.first_name (facultatif) : Prénom du destinataire
    - requires_2fa : Vrai si la double authentification sera exigée
    - role_label (facultatif) : Rôle attribué
  Configuration : config.firm_name
--}}
{{#> layout}}
{{#*inline "accent"}}#002B74{{/inline}}
{{#*inline "preheader"}}{{inviter.name}} vous invite à rejoindre l'espace collaborateurs.{{/inline}}
{{#*inline "content"}}
<tr><td style="padding-top:28px;padding-right:40px;padding-bottom:8px;padding-left:40px;"><h1 style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:22px;line-height:1.3;font-weight:bold;color:#002B74;">Invitation à rejoindre l'espace collaborateurs</h1><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">{{#if recipient.first_name}}Bonjour {{recipient.first_name}},{{else}}Bonjour,{{/if}}</p><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">{{inviter.name}} vous invite à rejoindre l'espace collaborateurs de {{config.firm_name}}{{#if role_label}} en tant que <strong>{{role_label}}</strong>{{/if}}.</p>{{#if requires_2fa}}<p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Pour protéger les données des dossiers, la double authentification vous sera demandée lors de votre première connexion.</p>{{/if}}<table role="presentation" align="center" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin-top:0;margin-right:auto;margin-bottom:0;margin-left:auto;"><tr><td align="center" bgcolor="#002B74" style="border-radius:6px;padding-top:15px;padding-right:28px;padding-bottom:15px;padding-left:28px;background-color:#002B74;"><a href="{{invitation_url}}" target="_blank" style="display:block;font-family:Arial, Helvetica, sans-serif;font-size:17px;line-height:20px;font-weight:bold;color:#FFFFFF;text-decoration:none;">Activer mon compte</a></td></tr></table><p style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-size:0;line-height:0;">&nbsp;</p>{{#if expires_in}}<p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.65;color:#5D7087;text-align:center;">Ce lien est valable {{expires_in}}.</p>{{/if}}<p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.65;color:#5D7087;">Si le bouton ne fonctionne pas, copiez ce lien dans votre navigateur :<br><a href="{{invitation_url}}" target="_blank" style="color:#002B74;text-decoration:underline;word-break:break-all;">{{invitation_url}}</a></p><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.65;color:#5D7087;">Si vous ne vous attendiez pas à cette invitation, vous pouvez ignorer ce message.</p></td></tr>
<tr><td style="padding-top:8px;padding-right:40px;padding-bottom:36px;padding-left:40px;"><p style="margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Cordialement,</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.6;color:#111827;"><strong>L'équipe {{config.firm_name}}</strong></p></td></tr>
{{/inline}}
{{/layout}}
