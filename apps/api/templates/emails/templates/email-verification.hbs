{{!--
  email-verification.hbs : Vérification d'adresse e-mail
  Destinataire : tout utilisateur
  Gabarit : layout.hbs (mention « Merci de ne pas répondre »)
  Objet : subjects.json, clé « email-verification »
  Données :
    - expires_in (facultatif) : Durée de validité du lien (ex. 24 heures)
    - recipient.email : Adresse e-mail du destinataire
    - recipient.first_name (facultatif) : Prénom du destinataire
    - verification_code (facultatif) : Code de vérification à saisir
    - verification_url : Lien de confirmation de l'adresse
  Configuration : config.firm_name
--}}
{{#> layout}}
{{#*inline "accent"}}#002B74{{/inline}}
{{#*inline "preheader"}}Confirmez votre adresse e-mail pour finaliser votre accès.{{/inline}}
{{#*inline "content"}}
<tr><td style="padding-top:28px;padding-right:40px;padding-bottom:8px;padding-left:40px;"><h1 style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:22px;line-height:1.3;font-weight:bold;color:#002B74;">Confirmez votre adresse e-mail</h1><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">{{#if recipient.first_name}}Bonjour {{recipient.first_name}},{{else}}Bonjour,{{/if}}</p><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Pour confirmer que l'adresse <strong>{{recipient.email}}</strong> vous appartient, cliquez sur le bouton ci-dessous.</p><table role="presentation" align="center" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin-top:0;margin-right:auto;margin-bottom:0;margin-left:auto;"><tr><td align="center" bgcolor="#002B74" style="border-radius:6px;padding-top:15px;padding-right:28px;padding-bottom:15px;padding-left:28px;background-color:#002B74;"><a href="{{verification_url}}" target="_blank" style="display:block;font-family:Arial, Helvetica, sans-serif;font-size:17px;line-height:20px;font-weight:bold;color:#FFFFFF;text-decoration:none;">Confirmer mon adresse</a></td></tr></table><p style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-size:0;line-height:0;">&nbsp;</p>{{#if expires_in}}<p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.65;color:#5D7087;text-align:center;">Ce lien est valable {{expires_in}}.</p>{{/if}}{{#if verification_code}}<p style="margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Vous pouvez aussi saisir ce code de vérification :</p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;"><tr><td align="center" bgcolor="#F3F6FA" style="padding-top:16px;padding-right:20px;padding-bottom:16px;padding-left:20px;border-radius:8px;font-family:Arial, Helvetica, sans-serif;font-size:28px;line-height:1.2;font-weight:bold;letter-spacing:6px;color:#111827;text-align:center;background-color:#F3F6FA;">{{verification_code}}</td></tr></table>{{/if}}<p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.65;color:#5D7087;">Si le bouton ne fonctionne pas, copiez ce lien dans votre navigateur :<br><a href="{{verification_url}}" target="_blank" style="color:#002B74;text-decoration:underline;word-break:break-all;">{{verification_url}}</a></p><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.65;color:#5D7087;">Si vous n'êtes pas à l'origine de cette demande, ignorez simplement ce message.</p></td></tr>
<tr><td style="padding-top:8px;padding-right:40px;padding-bottom:36px;padding-left:40px;"><p style="margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Cordialement,</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.6;color:#111827;"><strong>L'équipe {{config.firm_name}}</strong></p></td></tr>
{{/inline}}
{{/layout}}
