{{!--
  creditor-password-reset.hbs : Réinitialisation du mot de passe créancier
  Destinataire : créancier
  Gabarit : layout.hbs (mention « Merci de ne pas répondre »)
  Objet : subjects.json, clé « creditor-password-reset »
  Données :
    - expires_in (facultatif) : Durée de validité du lien (ex. 24 heures)
    - recipient.first_name (facultatif) : Prénom du destinataire
    - requested_at (facultatif) : Date de la demande
    - reset_url : Lien de réinitialisation
  Configuration : config.firm_name, config.support_email
--}}
{{#> layout}}
{{#*inline "accent"}}#002B74{{/inline}}
{{#*inline "preheader"}}Lien de réinitialisation de votre mot de passe.{{/inline}}
{{#*inline "content"}}
<tr><td style="padding-top:28px;padding-right:40px;padding-bottom:8px;padding-left:40px;"><h1 style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:22px;line-height:1.3;font-weight:bold;color:#002B74;">Réinitialisation de votre mot de passe</h1><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">{{#if recipient.first_name}}Bonjour {{recipient.first_name}},{{else}}Bonjour,{{/if}}</p><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Nous avons reçu une demande de réinitialisation du mot de passe de votre espace créancier{{#if requested_at}} le {{requested_at}}{{/if}}.</p><table role="presentation" align="center" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin-top:0;margin-right:auto;margin-bottom:0;margin-left:auto;"><tr><td align="center" bgcolor="#002B74" style="border-radius:6px;padding-top:15px;padding-right:28px;padding-bottom:15px;padding-left:28px;background-color:#002B74;"><a href="{{reset_url}}" target="_blank" style="display:block;font-family:Arial, Helvetica, sans-serif;font-size:17px;line-height:20px;font-weight:bold;color:#FFFFFF;text-decoration:none;">Choisir un mot de passe</a></td></tr></table><p style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-size:0;line-height:0;">&nbsp;</p>{{#if expires_in}}<p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.65;color:#5D7087;text-align:center;">Ce lien est valable {{expires_in}}.</p>{{/if}}<p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.65;color:#5D7087;">Si le bouton ne fonctionne pas, copiez ce lien dans votre navigateur :<br><a href="{{reset_url}}" target="_blank" style="color:#002B74;text-decoration:underline;word-break:break-all;">{{reset_url}}</a></p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;"><tr><td bgcolor="#FFF7ED" style="padding-top:18px;padding-right:20px;padding-bottom:18px;padding-left:20px;border-left:4px solid #C2410C;background-color:#FFF7ED;"><p style="margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:16px;line-height:1.4;font-weight:bold;color:#C2410C;">Vous n'êtes pas à l'origine de cette demande ?</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.65;color:#1F2937;">Ignorez ce message : votre mot de passe actuel reste valable. Si ces demandes se répètent, prévenez <a href="mailto:{{config.support_email}}" target="_blank" style="color:#002B74;text-decoration:underline;">{{config.support_email}}</a>.</p></td></tr></table></td></tr>
<tr><td style="padding-top:24px;padding-right:40px;padding-bottom:36px;padding-left:40px;"><p style="margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Cordialement,</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.6;color:#111827;"><strong>L'équipe {{config.firm_name}}</strong></p></td></tr>
{{/inline}}
{{/layout}}
