{{!--
  staff-2fa-enabled.hbs : Double authentification activée
  Destinataire : collaborateur
  Gabarit : layout.hbs (mention « Merci de ne pas répondre »)
  Objet : subjects.json, clé « staff-2fa-enabled »
  Données :
    - event.date : Date de l'activation
    - event.ip (facultatif) : Adresse IP
    - event.method_label (facultatif) : Méthode de double authentification
    - recipient.first_name (facultatif) : Prénom du destinataire
  Configuration : config.firm_name, config.support_email
--}}
{{#> layout}}
{{#*inline "accent"}}#15803D{{/inline}}
{{#*inline "preheader"}}La double authentification est activée sur votre compte.{{/inline}}
{{#*inline "content"}}
<tr><td style="padding-top:28px;padding-right:40px;padding-bottom:8px;padding-left:40px;"><h1 style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:22px;line-height:1.3;font-weight:bold;color:#15803D;">Double authentification activée</h1><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">{{#if recipient.first_name}}Bonjour {{recipient.first_name}},{{else}}Bonjour,{{/if}}</p><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">La double authentification a été activée sur votre compte collaborateur. Un code vous sera désormais demandé à chaque connexion, en plus de votre mot de passe.</p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;border:1px solid #E2E8F0;border-radius:8px;margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;"><tr><td style="padding-top:4px;padding-right:18px;padding-bottom:4px;padding-left:18px;"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;"><tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Date</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{event.date}}</td></tr>{{#if event.method_label}}<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Méthode</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{event.method_label}}</td></tr>{{/if}}{{#if event.ip}}<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Adresse IP</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{event.ip}}</td></tr>{{/if}}</table></td></tr></table><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;"><tr><td bgcolor="#FEF2F2" style="padding-top:18px;padding-right:20px;padding-bottom:18px;padding-left:20px;border-left:4px solid #B91C1C;background-color:#FEF2F2;"><p style="margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:16px;line-height:1.4;font-weight:bold;color:#B91C1C;">Ce n'est pas vous ?</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.65;color:#1F2937;">Prévenez immédiatement <a href="mailto:{{config.support_email}}" target="_blank" style="color:#002B74;text-decoration:underline;">{{config.support_email}}</a> : une autre personne a peut-être accès à votre compte.</p></td></tr></table></td></tr>
<tr><td style="padding-top:24px;padding-right:40px;padding-bottom:36px;padding-left:40px;"><p style="margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Cordialement,</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.6;color:#111827;"><strong>L'équipe {{config.firm_name}}</strong></p></td></tr>
{{/inline}}
{{/layout}}
