{{!--
  ops-alert.hbs : Alerte d'exploitation
  Destinataire : équipe technique
  Gabarit : layout.hbs (mention « Merci de ne pas répondre »)
  Objet : subjects.json, clé « ops-alert »
  Données :
    - alert.dashboard_url (facultatif) : Lien du tableau de bord
    - alert.description : Description
    - alert.details (facultatif) : Détails techniques (texte préformaté)
    - alert.environment (facultatif) : Environnement
    - alert.is_critical : Vrai pour une alerte critique (rouge)
    - alert.metrics (facultatif) : Mesures
    - alert.metrics[].label : Indicateur
    - alert.metrics[].value : Valeur
    - alert.resolved_at (facultatif) : Fin de l'incident
    - alert.runbook_url (facultatif) : Lien de la procédure d'intervention
    - alert.service : Service concerné
    - alert.severity_label : Sévérité affichée (ex. CRITIQUE)
    - alert.started_at : Début de l'incident
    - alert.title : Titre de l'alerte
  Configuration : config.firm_name
--}}
{{#> layout}}
{{#*inline "accent"}}{{#if alert.is_critical}}#B91C1C{{else}}#C2410C{{/if}}{{/inline}}
{{#*inline "preheader"}}{{alert.severity_label}} : {{alert.title}} ({{alert.service}}).{{/inline}}
{{#*inline "content"}}
<tr><td style="padding-top:28px;padding-right:40px;padding-bottom:8px;padding-left:40px;"><table role="presentation" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin-top:0;margin-right:0;margin-bottom:14px;margin-left:0;"><tr><td bgcolor="{{#if alert.is_critical}}#B91C1C{{else}}#C2410C{{/if}}" style="border-radius:4px;padding-top:6px;padding-right:12px;padding-bottom:6px;padding-left:12px;font-family:Arial, Helvetica, sans-serif;font-size:11px;line-height:14px;font-weight:bold;letter-spacing:1px;color:#FFFFFF;background-color:{{#if alert.is_critical}}#B91C1C{{else}}#C2410C{{/if}};">{{alert.severity_label}}</td></tr></table><h1 style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:22px;line-height:1.3;font-weight:bold;color:{{#if alert.is_critical}}#B91C1C{{else}}#C2410C{{/if}};">{{alert.title}}</h1><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;border:1px solid #E2E8F0;border-radius:8px;margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;"><tr><td style="padding-top:4px;padding-right:18px;padding-bottom:4px;padding-left:18px;"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;"><tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Service</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{alert.service}}</td></tr>{{#if alert.environment}}<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Environnement</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{alert.environment}}</td></tr>{{/if}}<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Début</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{alert.started_at}}</td></tr>{{#if alert.resolved_at}}<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Résolution</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{alert.resolved_at}}</td></tr>{{/if}}</table></td></tr></table><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">{{alert.description}}</p>{{#if alert.metrics}}<p style="margin-top:8px;margin-right:0;margin-bottom:10px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;font-weight:bold;letter-spacing:1px;color:#5D7087;">MESURES</p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;"><tr><td align="left" style="padding-top:8px;padding-right:10px;padding-bottom:8px;padding-left:10px;border-bottom:2px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;font-weight:bold;letter-spacing:1px;color:#5D7087;text-align:left;">INDICATEUR</td><td align="right" style="padding-top:8px;padding-right:10px;padding-bottom:8px;padding-left:10px;border-bottom:2px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;font-weight:bold;letter-spacing:1px;color:#5D7087;text-align:right;">VALEUR</td></tr>{{#each alert.metrics}}<tr><td align="left" style="padding-top:9px;padding-right:10px;padding-bottom:9px;padding-left:10px;border-bottom:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.45;color:#111827;text-align:left;vertical-align:top;">{{label}}</td><td align="right" style="padding-top:9px;padding-right:10px;padding-bottom:9px;padding-left:10px;border-bottom:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.45;color:#111827;text-align:right;vertical-align:top;">{{value}}</td></tr>{{/each}}</table><p style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-size:0;line-height:0;">&nbsp;</p>{{/if}}{{#if alert.details}}<p style="margin-top:8px;margin-right:0;margin-bottom:10px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;font-weight:bold;letter-spacing:1px;color:#5D7087;">DÉTAILS</p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0;"><tr><td bgcolor="#F3F6FA" style="padding-top:14px;padding-right:16px;padding-bottom:14px;padding-left:16px;border-radius:6px;font-family:Consolas, 'Courier New', monospace;font-size:12px;line-height:1.5;color:#111827;white-space:pre-wrap;word-break:break-all;background-color:#F3F6FA;">{{alert.details}}</td></tr></table><p style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-size:0;line-height:0;">&nbsp;</p>{{/if}}{{#if alert.dashboard_url}}<table role="presentation" align="center" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin-top:0;margin-right:auto;margin-bottom:0;margin-left:auto;"><tr><td align="center" bgcolor="#002B74" style="border-radius:6px;padding-top:15px;padding-right:28px;padding-bottom:15px;padding-left:28px;background-color:#002B74;"><a href="{{alert.dashboard_url}}" target="_blank" style="display:block;font-family:Arial, Helvetica, sans-serif;font-size:17px;line-height:20px;font-weight:bold;color:#FFFFFF;text-decoration:none;">Ouvrir le tableau de bord</a></td></tr></table><p style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-size:0;line-height:0;">&nbsp;</p>{{/if}}{{#if alert.runbook_url}}<p style="margin-top:0;margin-right:0;margin-bottom:0px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.65;color:#374151;text-align:center;"><a href="{{alert.runbook_url}}" target="_blank" style="color:#002B74;text-decoration:underline;">Consulter la procédure d'intervention</a></p>{{/if}}</td></tr>
<tr><td style="padding-top:24px;padding-right:40px;padding-bottom:36px;padding-left:40px;"><p style="margin-top:0;margin-right:0;margin-bottom:0px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;"><strong>Supervision</strong><br><span style="color:#5D7087;">{{config.firm_name}}</span></p></td></tr>
{{/inline}}
{{/layout}}
