{{!--
  creditor-invitation.hbs : Invitation créancier
  Destinataire : créancier
  Gabarit : layout.hbs (mention « Merci de ne pas répondre »)
  Objet : subjects.json, clé « creditor-invitation »
  Données :
    - creditor.name : Nom du créancier mandant
    - expires_in (facultatif) : Durée de validité du lien (ex. 24 heures)
    - invitation_url : Lien d'activation de l'accès
    - inviter.name : Nom de la personne qui invite
    - recipient.first_name (facultatif) : Prénom du destinataire
  Configuration : config.firm_name
--}}
{{#> layout}}
{{#*inline "accent"}}#002B74{{/inline}}
{{#*inline "preheader"}}{{inviter.name}} vous invite à suivre les dossiers de {{creditor.name}}.{{/inline}}
{{#*inline "content"}}
<tr><td style="padding-top:28px;padding-right:40px;padding-bottom:8px;padding-left:40px;"><h1 style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:22px;line-height:1.3;font-weight:bold;color:#002B74;">Invitation à rejoindre l'espace créancier</h1><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">{{#if recipient.first_name}}Bonjour {{recipient.first_name}},{{else}}Bonjour,{{/if}}</p><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">{{inviter.name}} vous invite à accéder à l'espace créancier de {{config.firm_name}} pour suivre les dossiers de <strong>{{creditor.name}}</strong>.</p><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Depuis cet espace, vous pourrez suivre l'avancement des dossiers, échanger avec nos équipes, valider les demandes d'échéancier et consulter vos reversements et factures.</p><table role="presentation" align="center" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin-top:0;margin-right:auto;margin-bottom:0;margin-left:auto;"><tr><td align="center" bgcolor="#002B74" style="border-radius:6px;padding-top:15px;padding-right:28px;padding-bottom:15px;padding-left:28px;background-color:#002B74;"><a href="{{invitation_url}}" target="_blank" style="display:block;font-family:Arial, Helvetica, sans-serif;font-size:17px;line-height:20px;font-weight:bold;color:#FFFFFF;text-decoration:none;">Activer mon accès</a></td></tr></table><p style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-size:0;line-height:0;">&nbsp;</p>{{#if expires_in}}<p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.65;color:#5D7087;text-align:center;">Ce lien est valable {{expires_in}}.</p>{{/if}}<p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.65;color:#5D7087;">Si le bouton ne fonctionne pas, copiez ce lien dans votre navigateur :<br><a href="{{invitation_url}}" target="_blank" style="color:#002B74;text-decoration:underline;word-break:break-all;">{{invitation_url}}</a></p><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.65;color:#5D7087;">Si vous ne vous attendiez pas à cette invitation, vous pouvez ignorer ce message.</p></td></tr>
<tr><td style="padding-top:8px;padding-right:40px;padding-bottom:36px;padding-left:40px;"><p style="margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Cordialement,</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.6;color:#111827;"><strong>L'équipe {{config.firm_name}}</strong></p></td></tr>
{{/inline}}
{{/layout}}
