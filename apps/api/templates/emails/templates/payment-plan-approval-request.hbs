{{!--
  payment-plan-approval-request.hbs : Accord sur un échéancier au-delà du seuil
  Destinataire : créancier
  Gabarit : layout.hbs (mention « Merci de ne pas répondre »)
  Objet : subjects.json, clé « payment-plan-approval-request »
  Données :
    - approval_url : Lien de la page de décision
    - case.balance : Solde restant dû, formaté
    - case.reference : Référence du dossier
    - debtor.company_name : Raison sociale du débiteur
    - plan.debtor_comment (facultatif) : Commentaire du débiteur
    - plan.duration_label : Durée proposée (ex. 10 mois)
    - plan.firm_opinion (facultatif) : Avis du cabinet
    - plan.first_due_date : Date de la première échéance
    - plan.installment_amount : Montant des échéances
    - plan.installment_count : Nombre d'échéances
    - plan.last_due_date : Date de la dernière échéance
    - recipient.first_name (facultatif) : Prénom du destinataire
    - response_deadline (facultatif) : Date limite de réponse
  Configuration : config.firm_name, config.plan_approval_threshold
--}}
{{#> layout}}
{{#*inline "accent"}}#C2410C{{/inline}}
{{#*inline "preheader"}}{{debtor.company_name}} propose un échéancier sur {{plan.duration_label}} : votre accord est nécessaire.{{/inline}}
{{#*inline "content"}}
<tr><td style="padding-top:28px;padding-right:40px;padding-bottom:8px;padding-left:40px;"><table role="presentation" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin-top:0;margin-right:0;margin-bottom:14px;margin-left:0;"><tr><td bgcolor="#C2410C" style="border-radius:4px;padding-top:6px;padding-right:12px;padding-bottom:6px;padding-left:12px;font-family:Arial, Helvetica, sans-serif;font-size:11px;line-height:14px;font-weight:bold;letter-spacing:1px;color:#FFFFFF;background-color:#C2410C;">VOTRE ACCORD EST NÉCESSAIRE</td></tr></table><h1 style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:22px;line-height:1.3;font-weight:bold;color:#002B74;">Demande d'échéancier à valider</h1><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">{{#if recipient.first_name}}Bonjour {{recipient.first_name}},{{else}}Bonjour,{{/if}}</p><p style="margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Le débiteur <strong>{{debtor.company_name}}</strong> (dossier n° {{case.reference}}) propose un échéancier sur <strong>{{plan.duration_label}}</strong>. Au-delà de {{config.plan_approval_threshold}}, un échéancier nécessite votre accord.</p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;border:1px solid #E2E8F0;border-radius:8px;"><tr><td style="padding-top:4px;padding-right:18px;padding-bottom:4px;padding-left:18px;"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;"><tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Montant restant dû</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{case.balance}}</td></tr>
<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Nombre d'échéances</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{plan.installment_count}}</td></tr>
<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Montant des échéances</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{plan.installment_amount}}</td></tr>
<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Première échéance</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{plan.first_due_date}}</td></tr>
<tr><td width="42%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.4;color:#5D7087;">Dernière échéance</td><td width="58%" style="padding-top:10px;padding-right:0;padding-bottom:10px;padding-left:0;border-top:1px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.4;font-weight:bold;color:#111827;">{{plan.last_due_date}}</td></tr></table></td></tr></table>{{#if plan.debtor_comment}}<p style="margin-top:24px;margin-right:0;margin-bottom:10px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;font-weight:bold;letter-spacing:1px;color:#5D7087;">COMMENTAIRE DU DÉBITEUR</p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0;"><tr><td bgcolor="#F3F6FA" style="padding-top:14px;padding-right:18px;padding-bottom:14px;padding-left:18px;border-left:3px solid #E2E8F0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.6;font-style:italic;color:#374151;background-color:#F3F6FA;">« {{plan.debtor_comment}} »</td></tr></table>{{/if}}{{#if plan.firm_opinion}}<p style="margin-top:24px;margin-right:0;margin-bottom:10px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;font-weight:bold;letter-spacing:1px;color:#5D7087;">AVIS DU CABINET</p><p style="margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">{{plan.firm_opinion}}</p>{{/if}}<p style="margin-top:0;margin-right:0;margin-bottom:20px;margin-left:0;font-size:0;line-height:0;">&nbsp;</p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;"><tr><td bgcolor="#FFF7ED" style="padding-top:18px;padding-right:20px;padding-bottom:18px;padding-left:20px;border-left:4px solid #C2410C;background-color:#FFF7ED;"><p style="margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:16px;line-height:1.4;font-weight:bold;color:#C2410C;">Réponse attendue {{#if response_deadline}}avant le <strong>{{response_deadline}}</strong>{{else}}<strong>dès que possible</strong>{{/if}}</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.65;color:#1F2937;">Tant que vous ne vous êtes pas prononcé, l'échéancier n'est pas mis en place.</p></td></tr></table></td></tr>
<tr><td style="padding-top:24px;padding-right:40px;padding-bottom:8px;padding-left:40px;"><table role="presentation" align="center" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin-top:0;margin-right:auto;margin-bottom:0;margin-left:auto;"><tr><td align="center" bgcolor="#002B74" style="border-radius:6px;padding-top:15px;padding-right:28px;padding-bottom:15px;padding-left:28px;background-color:#002B74;"><a href="{{approval_url}}" target="_blank" style="display:block;font-family:Arial, Helvetica, sans-serif;font-size:17px;line-height:20px;font-weight:bold;color:#FFFFFF;text-decoration:none;">Examiner la demande</a></td></tr></table></td></tr>
<tr><td style="padding-top:24px;padding-right:40px;padding-bottom:36px;padding-left:40px;"><p style="margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#374151;">Cordialement,</p><p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.6;color:#111827;"><strong>L'équipe {{config.firm_name}}</strong></p></td></tr>
{{/inline}}
{{/layout}}
