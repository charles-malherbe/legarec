{{!--
  reminder-1.hbs : Relance niveau 1 (normale)
  Destinataire : débiteur
  Gabarit : layout.hbs ; mentions remplacées par mentions_recouvrement (réponses acceptées)
  Objet : subjects.json, clé « reminder-1 »
  Données :
    - case.access_code (facultatif) : Code de paiement de l'espace débiteur
    - case.deadline (facultatif) : Date limite de règlement ; à défaut, délai standard du niveau
    - case.reference : Référence du dossier
    - case.total_due : Total à régler, formaté (ex. 11 445,48 €)
    - creditor.establishment (facultatif) : Établissement du créancier (ex. école), affiché en gras
    - creditor.name : Nom du créancier mandant
    - debtor.company_name : Raison sociale du débiteur
    - debtor.contact_name (facultatif) : Personne à l'attention de laquelle le courrier est adressé
    - debtor.siren : SIREN du débiteur (identifiant de l'espace débiteur)
    - invoices : Factures du dossier (une carte par facture, pluriel automatique)
    - invoices[].due_date : Date d'échéance
    - invoices[].interest (facultatif) : Intérêts légaux
    - invoices[].issue_date : Date d'émission
    - invoices[].late_fees (facultatif) : Pénalités de retard
    - invoices[].number : Numéro de facture
    - invoices[].principal : Montant initial
    - invoices[].total : Total de la facture
  Configuration : config.account_holder, config.bank_name, config.bic, config.cheque_address, config.cheque_payee, config.collection_email, config.firm_name, config.iban, config.phone, config.phone_href, config.portal_label, config.portal_url
--}}
