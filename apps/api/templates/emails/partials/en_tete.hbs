{{!--
  en_tete.hbs : logo si config.logo_url est renseigné (texte alternatif : nom du cabinet),
  sinon nom et sous-titre du cabinet en texte. Remplaçable.
  Configuration : config.firm_name, config.firm_tagline, config.logo_dark_url, config.logo_url, config.logo_width
--}}
{{#if config.logo_url}}<img class="logo-light" src="{{config.logo_url}}" width="{{#if config.logo_width}}{{config.logo_width}}{{else}}260{{/if}}" alt="{{config.firm_name}}" border="0" style="display:block;margin-top:0;margin-right:auto;margin-bottom:0;margin-left:auto;width:{{#if config.logo_width}}{{config.logo_width}}{{else}}260{{/if}}px;max-width:100%;height:auto;border:0;outline:none;text-decoration:none;font-family:Arial, Helvetica, sans-serif;font-size:24px;line-height:1.2;font-weight:bold;color:#002B74;">{{#if config.logo_dark_url}}<div class="logo-dark" style="display:none;max-height:0;overflow:hidden;mso-hide:all;"><img src="{{config.logo_dark_url}}" width="{{#if config.logo_width}}{{config.logo_width}}{{else}}260{{/if}}" alt="{{config.firm_name}}" border="0" style="display:block;margin-top:0;margin-right:auto;margin-bottom:0;margin-left:auto;width:{{#if config.logo_width}}{{config.logo_width}}{{else}}260{{/if}}px;max-width:100%;height:auto;border:0;outline:none;text-decoration:none;mso-hide:all;"></div>{{/if}}{{else}}<p style="margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:34px;line-height:1.1;font-weight:bold;letter-spacing:3px;text-transform:uppercase;color:#002B74;text-align:center;">{{config.firm_name}}</p>{{#if config.firm_tagline}}<p style="margin-top:8px;margin-right:0;margin-bottom:0;margin-left:0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.4;font-weight:bold;letter-spacing:3px;text-transform:uppercase;color:#5D7087;text-align:center;">{{config.firm_tagline}}</p>{{/if}}{{/if}}
