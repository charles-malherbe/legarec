enum CreditorStatus {
  ACTIVE
  ENDED

  @@map("creditor_status")
}

enum DebtorKind {
  COMPANY
  SOLE_TRADER
  INDIVIDUAL

  @@map("debtor_kind")
}

enum CaseStatus {
  NEW
  OVERDUE
  REMINDER
  FORMAL_NOTICE
  PROMISE
  PLAN
  DISPUTE
  LITIGATION
  SETTLED
  LOST

  @@map("case_status")
}

enum EventTone {
  danger
  info
  warning
  success
  neutral

  @@map("event_tone")
}

enum ActorKind {
  STAFF
  CREDITOR
  DEBTOR
  SERVICE
  HOOK
  SYSTEM
  ANONYMOUS

  @@map("actor_kind")
}

model Creditor {
  id            String         @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  name          String
  siren         String?        @unique
  status        CreditorStatus @default(ACTIVE)
  portalEnabled Boolean        @default(true) @map("portal_enabled")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  legalName     String?        @map("legal_name")
  vatNumber     String?        @map("vat_number")
  sector        String?
  address       String?
  postalCode    String?        @map("postal_code")
  city          String?
  managerId     String?        @map("manager_id") @db.Uuid
  version       Int            @default(1)
  updatedBy     String?        @map("updated_by") @db.Uuid
  updatedAt     DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)

  users        User[]                @relation("AccountsOfCreditor")
  manager      User?                 @relation("ManagedCreditors", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cases        Case[]
  contacts     CreditorContact[]
  mandates     Mandate[]
  bankAccounts CreditorBankAccount[]

  @@map("creditors")
}

model CreditorContact {
  id         String   @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  creditorId String   @map("creditor_id") @db.Uuid
  name       String
  title      String?
  email      String   @db.Citext
  phone      String?
  isMain     Boolean  @default(false) @map("is_main")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  creditor Creditor @relation(fields: [creditorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([creditorId], map: "creditor_contacts_creditor")
  @@map("creditor_contacts")
}

enum MandateInterest {
  ECB_PLUS_TEN
  CONTRACT
  NONE

  @@map("mandate_interest")
}

enum ScenarioCode {
  BUSINESS
  CONSUMER
  KEY_ACCOUNTS

  @@map("scenario_code")
}

/// One line per version; never two at the same time (exclusion in SQL).
model Mandate {
  id                       String          @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  creditorId               String          @map("creditor_id") @db.Uuid
  amendsId                 String?         @map("amends_id") @db.Uuid
  startsOn                 DateTime        @map("starts_on") @db.Date
  endsOn                   DateTime?       @map("ends_on") @db.Date
  amicableRateBp           Int             @map("amicable_rate_bp")
  litigationRateBp         Int             @map("litigation_rate_bp")
  openingFeeCents          Int             @default(0) @map("opening_fee_cents")
  planMonthsWithoutConsent Int             @map("plan_months_without_consent")
  discountMaxBp            Int             @map("discount_max_bp")
  litigationNeedsConsent   Boolean         @map("litigation_needs_consent")
  deferSmallRemittances    Boolean         @default(false) @map("defer_small_remittances")
  interestMode             MandateInterest @map("interest_mode")
  contractRateBp           Int?            @map("contract_rate_bp")
  fixedIndemnity           Boolean         @map("fixed_indemnity")
  reportingDay             Int             @map("reporting_day")
  scenario                 ScenarioCode
  createdBy                String?         @map("created_by") @db.Uuid
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  creditor Creditor  @relation(fields: [creditorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  amends   Mandate?  @relation("Amendments", fields: [amendsId, creditorId], references: [id, creditorId], onDelete: NoAction, onUpdate: NoAction)
  amended  Mandate[] @relation("Amendments")
  cases    Case[]

  @@unique([id, creditorId], map: "mandates_id_creditor")
  @@map("mandates")
}

/// The IBAN is encrypted by the API, and read by app.creditor_iban() alone.
model CreditorBankAccount {
  id            String    @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  creditorId    String    @map("creditor_id") @db.Uuid
  holder        String
  ibanCipher    Bytes     @map("iban_cipher")
  ibanMasked    String    @map("iban_masked")
  bic           String
  validFrom     DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil    DateTime? @map("valid_until") @db.Timestamptz(3)
  confirmedBy   String?   @map("confirmed_by") @db.Uuid
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz(3)
  confirmedWith String?   @map("confirmed_with")
  createdBy     String    @map("created_by") @db.Uuid
  onBehalfOfId  String?   @map("on_behalf_of_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  creditor Creditor @relation(fields: [creditorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("creditor_bank_accounts")
}

/// SIREN unique when present (partial unique index in SQL); never for an individual.
model Debtor {
  id                 String     @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  kind               DebtorKind
  name               String
  siren              String?
  legalFormCode      String?    @map("legal_form_code")
  legalFormSource    String?    @map("legal_form_source")
  legalFormCheckedAt DateTime?  @map("legal_form_checked_at") @db.Timestamptz(3)
  anonymizedAt       DateTime?  @map("anonymized_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  /// False while only a creditor has named it: the team, opening a case under the confirmed name, replaces it.
  nameConfirmed Boolean @default(true) @map("name_confirmed")

  cases      Case[]
  accessCode DebtorAccessCode?
  sessions   DebtorSession[]

  @@map("debtors")
}

/// One code per debtor, for all their cases; read through app.access_code().
model DebtorAccessCode {
  debtorId    String   @id @map("debtor_id") @db.Uuid
  codeCipher  Bytes    @map("code_cipher")
  /// Keyed fingerprint of the code in force: what the sign-in of the debtor compares.
  codeHmac    Bytes?   @map("code_hmac")
  version     Int      @default(1)
  generatedBy String?  @map("generated_by") @db.Uuid
  generatedAt DateTime @default(now()) @map("generated_at") @db.Timestamptz(3)

  debtor Debtor @relation(fields: [debtorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("debtor_access_codes")
}

/// Keyed digests; written by app.renew_access_code().
model DebtorRetiredCode {
  debtorId  String   @map("debtor_id") @db.Uuid
  codeHmac  Bytes    @map("code_hmac")
  retiredAt DateTime @default(now()) @map("retired_at") @db.Timestamptz(3)

  @@id([debtorId, codeHmac])
  @@map("debtor_retired_codes")
}

/// One open case at most per creditor and debtor (partial unique index in SQL).
model Case {
  id                   String     @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  reference            String     @unique
  creditorId           String     @map("creditor_id") @db.Uuid
  debtorId             String     @map("debtor_id") @db.Uuid
  officerId            String?    @map("officer_id") @db.Uuid
  status               CaseStatus @default(NEW)
  externalReference    String?    @map("external_reference")
  /// Postal letter only (LR-AAAA-NNNN): no reminder before it, and nothing shown to the debtor.
  firstLetterReference String?    @map("first_letter_reference")
  firstLetterOn        DateTime?  @map("first_letter_on") @db.Date
  openedOn             DateTime   @default(dbgenerated("((now() AT TIME ZONE 'Europe/Paris'::text))::date")) @map("opened_on") @db.Date
  closedOn             DateTime?  @map("closed_on") @db.Date
  version              Int        @default(1)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  /// The terms of the day it was opened.
  mandateId            String?    @map("mandate_id") @db.Uuid
  debtorSiret          String?    @map("debtor_siret")
  debtorAddress        String?    @map("debtor_address")
  debtorPostalCode     String?    @map("debtor_postal_code")
  debtorCity           String?    @map("debtor_city")
  contactName          String?    @map("contact_name")
  contactTitle         String?    @map("contact_title")
  scenario             ScenarioCode?
  createdBy            String?    @map("created_by") @db.Uuid
  /// Delivery of the formal notice of an individual, failing that its sending: interest runs from it (question 98).
  formalNoticeOn       DateTime?  @map("formal_notice_on") @db.Date
  /// The name of the debtor as a creditor gave it in its deposit: shown to that creditor, checked by the team.
  depositedName        String?    @map("deposited_name")
  /// Five years after it closed, everything it held about its debtor is gone (app.anonymize_case).
  anonymizedAt         DateTime?  @map("anonymized_at") @db.Timestamptz(3)
  /// Shown only: computed by PostgreSQL from `closedOn`.
  purgeAfter           DateTime?  @map("purge_after") @db.Date

  mandate  Mandate?    @relation(fields: [mandateId, creditorId], references: [id, creditorId], onDelete: NoAction, onUpdate: NoAction)
  invoices CaseInvoice[]
  contacts CaseContact[]
  creditor Creditor    @relation(fields: [creditorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  debtor   Debtor      @relation(fields: [debtorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  officer  User?       @relation(fields: [officerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events   CaseEvent[]
  notifications Notification[]
  payments Payment[]
  allocations PaymentAllocation[]
  receipts Receipt[]
  plans    PaymentPlan[]
  approvals PlanApproval[]
  installments Installment[]
  documents Document[]
  portalMessages PortalMessage[]
  plannedReminders PlannedReminder[]
  sendings         Sending[]
  litigation LitigationFile[]

  @@unique([id, creditorId], map: "cases_id_creditor")
  @@index([officerId, status], map: "cases_officer")
  @@index([creditorId, status], map: "cases_creditor")
  @@index([debtorId], map: "cases_debtor")
  @@map("cases")
}

enum InvoiceState {
  UNPAID
  PARTIAL
  DISPUTED
  REMINDED
  PLAN
  PAID

  @@map("invoice_state")
}

model CaseInvoice {
  id                 String       @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  caseId             String       @map("case_id") @db.Uuid
  creditorId         String       @map("creditor_id") @db.Uuid
  number             String
  externalRef        String?      @map("external_ref")
  issuedOn           DateTime     @map("issued_on") @db.Date
  dueOn              DateTime     @map("due_on") @db.Date
  claimedCents       Int          @map("claimed_cents")
  principalCents     Int          @map("principal_cents")
  principalPaidCents Int          @default(0) @map("principal_paid_cents")
  state              InvoiceState @default(UNPAID)
  createdBy          String?      @map("created_by") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  case Case @relation(fields: [caseId, creditorId], references: [id, creditorId], onDelete: NoAction, onUpdate: NoAction)

  allocations PaymentAllocation[]

  @@unique([caseId, number])
  @@unique([id, caseId], map: "case_invoices_id_case")
  @@map("case_invoices")
}

enum ContactKind {
  PHONE
  EMAIL

  @@map("contact_kind")
}

enum ContactStatus {
  VERIFIED
  INVALID
  UNVERIFIED
  NEW
  PENDING

  @@map("contact_status")
}

enum ContactSource {
  CALL
  IMPORT
  DOCUMENT
  CREDITOR

  @@map("contact_source")
}

/// Coordinates of the debtor for one creditor: never those of another (question 79).
model CaseContact {
  id              String        @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  caseId          String        @map("case_id") @db.Uuid
  creditorId      String        @map("creditor_id") @db.Uuid
  kind            ContactKind
  label           String
  value           String
  valueNormalized String        @map("value_normalized")
  status          ContactStatus @default(UNVERIFIED)
  isPrimary       Boolean       @default(false) @map("is_primary")
  source          ContactSource
  replacedById    String?       @map("replaced_by_id") @db.Uuid
  createdBy       String?       @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  invalidatedAt   DateTime?     @map("invalidated_at") @db.Timestamptz(3)

  case       Case               @relation(fields: [caseId, creditorId], references: [id, creditorId], onDelete: NoAction, onUpdate: NoAction)
  replacedBy CaseContact?       @relation("Replacement", fields: [replacedById, caseId], references: [id, caseId], onDelete: NoAction, onUpdate: NoAction)
  replaces   CaseContact[]      @relation("Replacement")
  events     CaseContactEvent[]

  sendings   Sending[]

  @@unique([id, caseId])
  @@index([valueNormalized], map: "case_contacts_lookup")
  @@map("case_contacts")
}

/// Append-only; written by app.note_contact() only.
model CaseContactEvent {
  id         String   @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  caseId     String   @map("case_id") @db.Uuid
  creditorId String   @map("creditor_id") @db.Uuid
  contactId  String   @map("contact_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorLabel String   @map("actor_label")
  what       String
  occurredAt DateTime @default(dbgenerated("clock_timestamp()")) @map("occurred_at") @db.Timestamptz(3)

  contact CaseContact @relation(fields: [contactId, caseId], references: [id, caseId], onDelete: NoAction, onUpdate: NoAction)

  @@index([caseId, occurredAt(sort: Desc)], map: "case_contact_events_case")
  @@map("case_contact_events")
}

/// Append-only; written by app.add_case_event() only.
model CaseEvent {
  id                String    @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  caseId            String    @map("case_id") @db.Uuid
  creditorId        String    @map("creditor_id") @db.Uuid
  kind              String
  title             String
  detail            String?
  tone              EventTone @default(neutral)
  actorKind         ActorKind @map("actor_kind")
  actorId           String?   @map("actor_id") @db.Uuid
  actorLabel        String    @map("actor_label")
  onBehalfOfId      String?   @map("on_behalf_of_id") @db.Uuid
  visibleToCreditor Boolean   @default(false) @map("visible_to_creditor")
  occurredAt        DateTime  @default(dbgenerated("clock_timestamp()")) @map("occurred_at") @db.Timestamptz(3)

  case       Case  @relation(fields: [caseId, creditorId], references: [id, creditorId], onDelete: NoAction, onUpdate: NoAction)
  onBehalfOf User? @relation(fields: [onBehalfOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([caseId, occurredAt(sort: Desc)], map: "case_events_case")
  @@index([occurredAt], map: "case_events_recent")
  @@map("case_events")
}

/// Opened by the sign-in of a debtor (`app.open_debtor_session()`), read again at each request.
model DebtorSession {
  id         String    @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  debtorId   String    @map("debtor_id") @db.Uuid
  tokenHash  Bytes     @unique @map("token_hash")
  ip         String?   @db.Inet
  persistent Boolean   @default(false)
  lastSeenAt DateTime  @default(dbgenerated("now()")) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(3)

  debtor Debtor @relation(fields: [debtorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("debtor_sessions")
}

/// A link of a letter or a text message: it fills the identifier in, never the code; read by `app.debtor_link()`.
model DebtorLink {
  id         String    @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  debtorId   String    @map("debtor_id") @db.Uuid
  caseId     String    @map("case_id") @db.Uuid
  creditorId String    @map("creditor_id") @db.Uuid
  tokenHash  Bytes     @unique @map("token_hash")
  channel    String
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  uses       Int       @default(0)
  createdAt  DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(3)

  @@map("debtor_links")
}

/// A message from someone without a code: unverified, read by the manager only, kept 6 months.
model LimitedMessage {
  id               String    @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  senderName       String    @map("sender_name")
  senderEmail      String?   @map("sender_email")
  claimedReference String?   @map("claimed_reference")
  text             String
  readAt           DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)], map: "limited_messages_created")
  @@map("limited_messages")
}

enum GdprKind {
  ACCESS
  RECTIFICATION
  OBJECTION
  ERASURE

  @@map("gdpr_kind")
}

enum GdprStatus {
  OPEN
  ANSWERED
  REFUSED

  @@map("gdpr_status")
}

/// A request of a debtor about their data; read and written by the `app.gdpr_*` functions only.
model GdprRequest {
  id           String     @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  caseId       String     @map("case_id") @db.Uuid
  creditorId   String     @map("creditor_id") @db.Uuid
  debtorId     String     @map("debtor_id") @db.Uuid
  kind         GdprKind
  origin       String
  receivedOn   DateTime   @default(dbgenerated("((now() AT TIME ZONE 'Europe/Paris'::text))::date")) @map("received_on") @db.Date
  dueOn        DateTime   @map("due_on") @db.Date
  status       GdprStatus @default(OPEN)
  reason       String?
  answeredAt   DateTime?  @map("answered_at") @db.Timestamptz(3)
  answeredBy   String?    @map("answered_by") @db.Uuid
  createdBy    String     @map("created_by") @db.Uuid
  onBehalfOfId String?    @map("on_behalf_of_id") @db.Uuid
  createdAt    DateTime   @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(3)

  @@index([receivedOn(sort: Desc)], map: "gdpr_requests_received")
  @@map("gdpr_requests")
}

enum PlannedKind {
  EMAIL
  SMS
  CALL
  LETTER

  @@map("planned_kind")
}

/// A reminder planned by hand in the agenda; sent with lot Q.
model PlannedReminder {
  id           String      @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  caseId       String      @map("case_id") @db.Uuid
  creditorId   String      @map("creditor_id") @db.Uuid
  kind         PlannedKind
  dueOn        DateTime    @map("due_on") @db.Date
  dueTime      String?     @map("due_time")
  title        String
  warning      String?
  doneAt       DateTime?   @map("done_at") @db.Timestamptz(3)
  createdBy    String      @default(dbgenerated("app.user_id()")) @map("created_by") @db.Uuid
  onBehalfOfId String?     @default(dbgenerated("app.on_behalf_of()")) @map("on_behalf_of_id") @db.Uuid
  createdAt    DateTime    @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(3)

  case Case @relation(fields: [caseId, creditorId], references: [id, creditorId], onDelete: NoAction, onUpdate: NoAction)

  @@index([dueOn], map: "planned_reminders_due")
  @@index([caseId], map: "planned_reminders_case")
  @@map("planned_reminders")
}

/// What leaves for a debtor (lot Q): an e-mail reminder, written with the request and sent by the worker.
model Sending {
  id            String         @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  caseId        String         @map("case_id") @db.Uuid
  creditorId    String         @map("creditor_id") @db.Uuid
  channel       SendingChannel
  template      String
  level         Int?
  contactId     String?        @map("contact_id") @db.Uuid
  documentId    String?        @map("document_id") @db.Uuid
  /// Written by the worker alone: never sent with the line.
  status        SendingStatus  @default(dbgenerated("'QUEUED'::sending_status"))
  simulated     Boolean        @default(dbgenerated("false"))
  providerRef   String?        @map("provider_ref")
  failure       String?
  /// Reason of a justified override of the contact cap (question 214).
  capOverrideReason String? @map("cap_override_reason")
  createdBy     String         @default(dbgenerated("app.user_id()")) @map("created_by") @db.Uuid
  onBehalfOfId  String?        @default(dbgenerated("app.on_behalf_of()")) @map("on_behalf_of_id") @db.Uuid
  createdAt     DateTime       @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(3)
  sentAt        DateTime?      @map("sent_at") @db.Timestamptz(3)
  /// What the provider said of it afterwards (webhooks of Resend): written once each, by the worker alone.
  confirmedAt   DateTime?      @map("confirmed_at") @db.Timestamptz(3)
  deliveredAt   DateTime?      @map("delivered_at") @db.Timestamptz(3)
  undeliveredAt DateTime?      @map("undelivered_at") @db.Timestamptz(3)
  undeliveredReason String?    @map("undelivered_reason")
  complainedAt  DateTime?      @map("complained_at") @db.Timestamptz(3)

  case     Case      @relation(fields: [caseId, creditorId], references: [id, creditorId], onDelete: NoAction, onUpdate: NoAction)
  contact  CaseContact? @relation(fields: [contactId, caseId], references: [id, caseId], onDelete: NoAction, onUpdate: NoAction)
  document Document?    @relation(fields: [documentId, caseId], references: [id, caseId], onDelete: NoAction, onUpdate: NoAction)

  @@index([caseId, createdAt], map: "sendings_case")
  @@index([status], map: "sendings_waiting")
  @@index([providerRef], map: "sendings_provider_ref")
  @@map("sendings")
}

enum SendingChannel {
  EMAIL
  LETTER
  REGISTERED_LETTER

  @@map("sending_channel")
}

enum SendingStatus {
  QUEUED
  SENT
  FAILED
  UNCERTAIN

  @@map("sending_status")
}

enum LitigationStage {
  FORMAL_NOTICE
  PAYMENT_ORDER
  ENFORCEABLE_TITLE
  ENFORCEMENT
  CLOSED

  @@map("litigation_stage")
}

enum LitigationConsent {
  NOT_NEEDED
  WAITING
  RECEIVED

  @@map("litigation_consent")
}

/// Litigation in a minimal follow-up (question 163): the stage, the court and the partner; the acts stay with the lawyer.
model LitigationFile {
  id             String            @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  caseId         String            @unique(map: "litigation_files_case") @map("case_id") @db.Uuid
  creditorId     String            @map("creditor_id") @db.Uuid
  stage          LitigationStage   @default(FORMAL_NOTICE)
  stageSince     DateTime          @default(dbgenerated("((now() AT TIME ZONE 'Europe/Paris'::text))::date")) @map("stage_since") @db.Date
  court          String?
  partnerName    String?           @map("partner_name")
  consent        LitigationConsent
  consentNotedBy String?           @map("consent_noted_by") @db.Uuid
  consentNotedAt DateTime?         @map("consent_noted_at") @db.Timestamptz(3)
  titleOn        DateTime?         @map("title_on") @db.Date
  createdBy      String            @default(dbgenerated("app.user_id()")) @map("created_by") @db.Uuid
  onBehalfOfId   String?           @default(dbgenerated("app.on_behalf_of()")) @map("on_behalf_of_id") @db.Uuid
  createdAt      DateTime          @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(3)
  version        Int               @default(1)

  case Case @relation(fields: [caseId, creditorId], references: [id, creditorId], onDelete: NoAction, onUpdate: NoAction)

  @@index([stage], map: "litigation_files_stage")
  @@map("litigation_files")
}

enum AiFeature {
  CASE_SUMMARY

  @@map("ai_feature")
}

enum AiOutcome {
  SUGGESTED
  REFUSED_BY_GUARD
  FAILED
  OVER_BUDGET

  @@map("ai_outcome")
}

enum AiDecision {
  PENDING
  ACCEPTED
  MODIFIED
  IGNORED
  REPORTED

  @@map("ai_decision")
}

/// The journal of the assistant: each suggestion, what it cost, and what a colleague decided (docs/ia.md).
model AiSuggestion {
  id            String     @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  feature       AiFeature
  caseId        String     @map("case_id") @db.Uuid
  creditorId    String     @map("creditor_id") @db.Uuid
  outcome       AiOutcome
  inputSummary  String     @map("input_summary")
  output        Json?
  model         String?
  promptVersion String     @map("prompt_version")
  inputTokens   Int        @default(0) @map("input_tokens")
  outputTokens  Int        @default(0) @map("output_tokens")
  costMicro     BigInt     @default(0) @map("cost_micro")
  events        Int        @default(0)
  decision      AiDecision @default(PENDING)
  decidedBy     String?    @map("decided_by") @db.Uuid
  decidedAt     DateTime?  @map("decided_at") @db.Timestamptz(3)
  decidedFor    String?    @map("decided_for") @db.Uuid
  askedBy       String?    @map("asked_by") @db.Uuid
  createdAt     DateTime   @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(3)

  @@index([caseId, createdAt(sort: Desc)], map: "ai_suggestions_case")
  @@index([createdAt], map: "ai_suggestions_month")
  @@map("ai_suggestions")
}
