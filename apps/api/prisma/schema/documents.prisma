enum DocumentCategory {
  REMINDER_LETTER
  FORMAL_NOTICE
  PAYMENT_PLAN
  INVOICE
  EVIDENCE
  COURT
  REMITTANCE
  RECEIPT

  @@map("document_category")
}

enum DocumentKind {
  PDF
  DOCX
  PNG
  JPEG

  @@map("document_kind")
}

enum DocumentSource {
  UPLOAD
  GENERATED
  CREDITOR
  DEBTOR

  @@map("document_source")
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED

  @@map("scan_status")
}

/// A file kept by `Storage` under `storageKey`; read only once `scanStatus` is CLEAN.
enum RetentionClass {
  CASE
  ACCOUNTING

  @@map("retention_class")
}

model Document {
  id                   String           @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  caseId               String?          @map("case_id") @db.Uuid
  creditorId           String?          @map("creditor_id") @db.Uuid
  category             DocumentCategory
  kind                 DocumentKind
  title                String
  originalName         String           @map("original_name")
  storageKey           String           @unique @map("storage_key")
  sizeBytes            Int              @map("size_bytes")
  sha256               String
  source               DocumentSource
  authorId             String?          @map("author_id") @db.Uuid
  sharedWithCreditorAt DateTime?        @map("shared_with_creditor_at") @db.Timestamptz(3)
  sharedBy             String?          @map("shared_by") @db.Uuid
  visibleToDebtor      Boolean          @default(false) @map("visible_to_debtor")
  containsAccessCode   Boolean          @default(false) @map("contains_access_code")
  scanStatus           ScanStatus       @default(PENDING) @map("scan_status")
  scannedAt            DateTime?        @map("scanned_at") @db.Timestamptz(3)
  /// A file of a debtor, waiting for their message.
  uploadedByDebtor     String?          @map("uploaded_by_debtor") @db.Uuid
  /// A file of a creditor, waiting for its claim.
  uploadedByCreditor   String?          @map("uploaded_by_creditor") @db.Uuid
  createdAt            DateTime         @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(3)
  /// Computed by PostgreSQL from the category: receipts and remittances are kept ten years.
  retentionClass       RetentionClass   @default(dbgenerated()) @map("retention_class")
  /// Its file is erased; nobody but the purge sees it any more.
  purgedAt             DateTime?        @map("purged_at") @db.Timestamptz(3)

  case     Case?     @relation(fields: [caseId, creditorId], references: [id, creditorId], onDelete: NoAction, onUpdate: NoAction)
  author   User?     @relation("documentAuthor", fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receipts Receipt[]
  sendings Sending[]
  attachedTo PortalMessageAttachment[]

  @@unique([id, caseId], map: "documents_id_case_id_key")
  @@index([caseId, createdAt(sort: Desc)], map: "documents_case")
  @@map("documents")
}

enum TemplateState {
  IMPORTED
  RESTORED
  WAITING
  PUBLISHED
  ARCHIVED
  REJECTED
  CANCELLED

  @@map("template_state")
}

/// Versions after the first (the catalogue of the contracts); written by the functions `app.*_template`.
model TemplateVersion {
  id            String        @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  templateCode  String        @map("template_code")
  number        Int?
  source        String
  fileName      String        @map("file_name")
  accepted      Boolean
  checks        Json
  hasWarnings   Boolean       @map("has_warnings")
  state         TemplateState
  importedBy    String        @map("imported_by") @db.Uuid
  submittedBy   String?       @map("submitted_by") @db.Uuid
  reviewedBy    String?       @map("reviewed_by") @db.Uuid
  onBehalfOfId  String?       @map("on_behalf_of_id") @db.Uuid
  reviewReason  String?       @map("review_reason")
  publishedAt   DateTime?     @map("published_at") @db.Timestamptz(3)
  updatedAt     DateTime      @default(dbgenerated("now()")) @map("updated_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(3)

  importer User @relation("templateImporter", fields: [importedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([templateCode, createdAt(sort: Desc)], map: "template_versions_code")
  @@map("template_versions")
}

enum MessageSide {
  DEBTOR
  STAFF

  @@map("message_side")
}

enum DebtorRequestKind {
  PLAN
  DISPUTE
  ALREADY_PAID
  CALLBACK

  @@map("debtor_request_kind")
}

/// Between the debtor and the team, on one case; written by `app.debtor_message()` and `app.staff_message()`.
model PortalMessage {
  id             String             @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  caseId         String             @map("case_id") @db.Uuid
  creditorId     String             @map("creditor_id") @db.Uuid
  side           MessageSide
  authorId       String?            @map("author_id") @db.Uuid
  text           String
  requestKind    DebtorRequestKind? @map("request_kind")
  requestData    Json?              @map("request_data")
  readByStaffAt  DateTime?          @map("read_by_staff_at") @db.Timestamptz(3)
  readByDebtorAt DateTime?          @map("read_by_debtor_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(3)

  case        Case                      @relation(fields: [caseId, creditorId], references: [id, creditorId], onDelete: NoAction, onUpdate: NoAction)
  author      User?                     @relation("portalAuthor", fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attachments PortalMessageAttachment[]

  @@unique([id, caseId], map: "portal_messages_id_case_id_key")
  @@index([caseId, createdAt], map: "portal_messages_case")
  @@map("portal_messages")
}

model PortalMessageAttachment {
  id         String @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  caseId     String @map("case_id") @db.Uuid
  creditorId String @map("creditor_id") @db.Uuid
  messageId  String @map("message_id") @db.Uuid
  documentId String @unique @map("document_id") @db.Uuid

  message  PortalMessage @relation(fields: [messageId, caseId], references: [id, caseId], onDelete: NoAction, onUpdate: NoAction)
  document Document      @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("portal_message_attachments")
}

enum ImportStatus {
  PENDING
  CONFIRMED

  @@map("import_status")
}

/// What the API understood of a file of claims; nothing is created before `confirmedAt`.
model ClaimImport {
  id           String       @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  creditorId   String       @map("creditor_id") @db.Uuid
  uploadedBy   String       @map("uploaded_by") @db.Uuid
  status       ImportStatus @default(PENDING)
  lines        Int
  valid        Int
  totalCents   BigInt       @map("total_cents")
  claims       Json
  errors       Json
  createdCount Int?         @map("created_count")
  confirmedAt  DateTime?    @map("confirmed_at") @db.Timestamptz(3)
  expiresAt    DateTime     @default(dbgenerated("(now() + '30 days'::interval)")) @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt], map: "claim_imports_expiry")
  @@map("claim_imports")
}

enum DepositStatus {
  PENDING
  ACCEPTED
  REFUSED

  @@map("deposit_status")
}

/// A claim deposited by a creditor, waiting for the Director or the manager before it becomes a case (question 155).
/// Written by app.creditor_deposit, app.accept_deposit and app.refuse_deposit only.
model ClaimDeposit {
  id           String        @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  creditorId   String        @map("creditor_id") @db.Uuid
  depositedBy  String        @map("deposited_by") @db.Uuid
  debtorName   String?       @map("debtor_name")
  siret        String?
  address      String?
  email        String?
  phone        String?
  invoices     Json?
  files        String[]      @default([]) @db.Uuid
  totalCents   BigInt        @map("total_cents")
  invoiceCount Int           @map("invoice_count")
  status       DepositStatus @default(PENDING)
  reason       String?
  decidedBy    String?       @map("decided_by") @db.Uuid
  onBehalfOfId String?       @map("on_behalf_of_id") @db.Uuid
  decidedAt    DateTime?     @map("decided_at") @db.Timestamptz(3)
  openedCase   String?       @map("opened_case") @db.Uuid
  createdAt    DateTime      @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt], map: "claim_deposits_waiting")
  @@index([creditorId, createdAt], map: "claim_deposits_day")
  @@index([decidedAt], map: "claim_deposits_decided_at")
  @@map("claim_deposits")
}
