enum SecretKind {
  SERVICE
  INTERNAL

  @@map("secret_kind")
}

enum SecretStatus {
  VALID
  REVOKE_PENDING
  REVOKED

  @@map("secret_status")
}

enum SecretRotation {
  DAYS_30
  DAYS_90
  MANUAL

  @@map("secret_rotation")
}

/// Keys of the services and internal keys. The value is encrypted by the API and never read by the team.
model VaultSecret {
  id          String         @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  name        SecretName
  kind        SecretKind
  valueCipher Bytes?         @map("value_cipher")
  status      SecretStatus   @default(VALID)
  rotation    SecretRotation @default(MANUAL)
  rotatedAt   DateTime       @default(now()) @map("rotated_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  requestedBy String?        @map("requested_by") @db.Uuid
  decidedBy   String?        @map("decided_by") @db.Uuid
  lastUsedAt  DateTime?      @map("last_used_at") @db.Timestamptz(3)

  @@map("vault_secrets")
}
